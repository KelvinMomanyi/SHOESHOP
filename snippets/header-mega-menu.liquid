{% doc %}
Renders a configurable header mega menu.

@param {block} block - Mega menu block settings.
@param {link} parent_link - Top-level navigation link.
@param {string} section_id - Header section identifier.
{% enddoc %}

{%- liquid
  assign mega_links = parent_link.links
  if block.settings.menu != blank
    assign mega_links = block.settings.menu.links
  endif
  assign promo_count = 0
  for i in (1..3)
    assign image_key = 'promo_image_' | append: i
    if block.settings[image_key] != blank
      assign promo_count = promo_count | plus: 1
    endif
  endfor
-%}

<div id="HeaderMegaMenu-{{ section_id }}-{{ block.id }}" class="site-header__mega-menu site-header__mega-menu--{{ block.settings.menu_layout }}" {{ block.shopify_attributes }}>
  <div class="site-header__mega-menu-inner page-width">
    {%- if mega_links != blank -%}
      <nav class="site-header__mega-links" aria-label="{{ parent_link.title | escape }}">
        <ul class="site-header__mega-columns" role="list">
          {%- for column_link in mega_links -%}
            <li class="site-header__mega-column">
              <a class="site-header__mega-heading" href="{{ column_link.url }}">{{ column_link.title }}</a>
              {%- if column_link.links != blank -%}
                <ul role="list">
                  {%- for child_link in column_link.links -%}
                    <li><a href="{{ child_link.url }}">{{ child_link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
    {%- if promo_count > 0 -%}
      <div class="site-header__mega-promos" style="--mega-promo-count: {{ promo_count }};">
        {%- for i in (1..3) -%}
          {%- liquid
            assign image_key = 'promo_image_' | append: i
            assign heading_key = 'promo_heading_' | append: i
            assign link_key = 'promo_link_' | append: i
            assign label_key = 'promo_label_' | append: i
            assign promo_image = block.settings[image_key]
            assign promo_heading = block.settings[heading_key]
            assign promo_link = block.settings[link_key]
            assign promo_label = block.settings[label_key]
          -%}
          {%- if promo_image != blank -%}
            {%- if promo_link != blank -%}
              <a class="site-header__mega-promo site-header__mega-promo--{{ block.settings.image_ratio }}" href="{{ promo_link }}">
            {%- else -%}
              <div class="site-header__mega-promo site-header__mega-promo--{{ block.settings.image_ratio }}">
            {%- endif -%}
              {%- render 'responsive-image',
                image: promo_image,
                class: 'site-header__mega-promo-image',
                sizes: '(min-width: 1400px) 22vw, 30vw',
                loading: 'lazy'
              -%}
              {%- if promo_heading != blank or promo_label != blank -%}
                <span class="site-header__mega-promo-content">
                  {%- if promo_heading != blank -%}<strong>{{ promo_heading }}</strong>{%- endif -%}
                  {%- if promo_label != blank -%}<span>{{ promo_label }}</span>{%- endif -%}
                </span>
              {%- endif -%}
            {%- if promo_link != blank -%}</a>{%- else -%}</div>{%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>
