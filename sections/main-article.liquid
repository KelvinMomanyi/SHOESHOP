<article class="article-editorial" id="Article-{{ section.id }}" data-article-reader data-outline-enabled="{{ section.settings.show_outline }}" data-motion-enabled="{{ section.settings.enable_motion }}">
  <div class="article-editorial__progress" data-reader-progress hidden aria-hidden="true"><span></span></div>
  <div class="page-width">
    <header class="article-editorial__header">
      <nav class="article-editorial__breadcrumbs" aria-label="{{ 'accessibility.breadcrumbs' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ blog.url }}">{{ blog.title | escape }}</a>
      </nav>
      <div class="article-editorial__masthead">
        <div>
          <p class="eyebrow">{{ article.tags.first | default: blog.title | escape }}</p>
          <h1 class="reveal-item">{{ article.title | escape }}</h1>
        </div>
        <div class="article-editorial__summary">
          {%- if section.settings.show_excerpt and article.excerpt != blank -%}
            <div class="article-editorial__excerpt rte">{{ article.excerpt }}</div>
          {%- endif -%}
          {%- if section.settings.show_date or section.settings.show_author -%}
            <div class="article-editorial__meta">
              {%- if section.settings.show_date -%}
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'abbreviated_date' }}</time>
              {%- endif -%}
              {%- if section.settings.show_author and article.author != blank -%}
                <span>{{ 'blog.articles.by_author' | t: author: article.author | escape }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </header>

    {%- if section.settings.show_image and article.image != blank -%}
      {%- assign cover_alt = article.image.alt | default: article.title -%}
      <div class="article-editorial__cover-stage" data-reader-cover-stage>
        <div class="article-editorial__cover" data-reader-cover>
          {%- render 'responsive-image',
            image: article.image,
            class: 'article-editorial__cover-image',
            sizes: '(min-width: 1400px) 1360px, 100vw',
            loading: 'eager',
            alt: cover_alt
          -%}
          <span class="article-editorial__cover-label" aria-hidden="true">{{ blog.title | escape }} / {{ article.tags.first | default: article.title | escape }}</span>
        </div>
      </div>
    {%- endif -%}

    <div class="article-editorial__reading-layout">
      <aside class="article-editorial__rail">
        <div class="article-editorial__rail-inner">
          <a class="text-link article-editorial__back" href="{{ blog.url }}"><span aria-hidden="true">&larr;</span>{{ 'blog.articles.back_to_blog' | t: blog: blog.title | escape }}</a>
          <details class="article-editorial__outline" data-reader-outline hidden>
            <summary>{{ 'blog.articles.on_this_page' | t }} <span aria-hidden="true">+</span></summary>
            <nav aria-label="{{ 'blog.articles.on_this_page' | t | escape }}">
              <ol data-reader-links></ol>
            </nav>
          </details>
        </div>
      </aside>
      <div class="article-editorial__reading">
        <div class="rte article-editorial__content" data-reader-content>
          {{ article.content }}
        </div>
        {%- if article.tags != blank -%}
          <nav class="article-editorial__tags" aria-label="{{ 'blog.articles.topics' | t | escape }}">
            <span>{{ 'blog.articles.topics' | t }}</span>
            {%- for tag in article.tags -%}
              {{ tag | link_to_tag: tag }}
            {%- endfor -%}
          </nav>
        {%- endif -%}
        <div class="article-editorial__endnote">
          <span>{{ blog.title | escape }}</span>
          <a class="text-link" href="{{ blog.url }}">{{ 'blog.articles.all_stories' | t }} <span aria-hidden="true">&nearr;</span></a>
        </div>

        {%- if section.settings.show_comments and blog.comments_enabled? -%}
          <section class="article-editorial__comments" aria-labelledby="ArticleComments-{{ section.id }}">
            <h2 id="ArticleComments-{{ section.id }}">{{ 'blog.comments.title' | t: count: article.comments_count }}</h2>
            {%- paginate article.comments by section.settings.comments_per_page -%}
              {%- for comment in article.comments -%}
                <article class="article-editorial__comment">
                  <div class="rte">{{ comment.content }}</div>
                  <footer><span>{{ comment.author | escape }}</span><time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: format: 'abbreviated_date' }}</time></footer>
                </article>
              {%- endfor -%}
              {%- render 'pagination', paginate: paginate -%}
            {%- endpaginate -%}

            {%- assign comment_form_id = 'CommentForm-' | append: section.id -%}
            {%- form 'new_comment', article, id: comment_form_id, class: 'comment-form article-editorial__comment-form' -%}
              <header>
                <p class="eyebrow">{{ 'blog.comments.join_conversation' | t }}</p>
                <h3>{{ 'blog.comments.leave' | t }}</h3>
                <p>{{ 'blog.comments.required_fields' | t }}</p>
              </header>
              {%- if form.posted_successfully? -%}
                <p class="form-status article-editorial__status" role="status" tabindex="-1" autofocus>{% if blog.moderated? %}{{ 'blog.comments.moderated_success' | t }}{% else %}{{ 'blog.comments.success' | t }}{% endif %}</p>
              {%- elsif form.errors -%}
                <div class="form-status form-status--error article-editorial__status" id="CommentErrors-{{ section.id }}" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
              {%- endif -%}
              <div class="article-editorial__comment-fields">
                <div>
                  <label for="CommentAuthor-{{ section.id }}">{{ 'blog.comments.name' | t }} <span aria-hidden="true">*</span></label>
                  <input id="CommentAuthor-{{ section.id }}" class="field__input" type="text" name="comment[author]" value="{{ form.author | escape }}" autocomplete="name" required{% if form.errors contains 'author' %} aria-invalid="true" aria-describedby="CommentErrors-{{ section.id }}"{% endif %}>
                </div>
                <div>
                  <label for="CommentEmail-{{ section.id }}">{{ 'blog.comments.email' | t }} <span aria-hidden="true">*</span></label>
                  <input id="CommentEmail-{{ section.id }}" class="field__input" type="email" name="comment[email]" value="{{ form.email | escape }}" autocomplete="email" autocorrect="off" autocapitalize="off" required{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="CommentErrors-{{ section.id }}"{% endif %}>
                </div>
              </div>
              <div>
                <label for="CommentBody-{{ section.id }}">{{ 'blog.comments.comment' | t }} <span aria-hidden="true">*</span></label>
                <textarea id="CommentBody-{{ section.id }}" class="field__input" name="comment[body]" rows="5" required{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="CommentErrors-{{ section.id }}"{% endif %}>{{ form.body | escape }}</textarea>
              </div>
              {%- if blog.moderated? -%}
                <p class="article-editorial__moderation">{{ 'blog.comments.moderated_notice' | t }}</p>
              {%- endif -%}
              <button class="button article-editorial__submit" type="submit">{{ 'blog.comments.post' | t }} <span aria-hidden="true">&nearr;</span></button>
            {%- endform -%}
          </section>
        {%- endif -%}
      </div>
    </div>

    {%- if blog.previous_article or blog.next_article -%}
      <nav class="article-editorial__next" aria-labelledby="KeepReading-{{ section.id }}">
        <header>
          <p class="eyebrow">{{ blog.title | escape }}</p>
          <h2 id="KeepReading-{{ section.id }}">{{ 'blog.articles.keep_reading' | t }}</h2>
        </header>
        <div class="article-editorial__next-grid">
          {%- if blog.previous_article -%}
            <a class="article-editorial__next-story" href="{{ blog.previous_article.url }}">
              <span class="eyebrow">{{ 'blog.articles.newer_story' | t }}</span>
              <strong>{{ blog.previous_article.title | escape }}</strong>
              <span class="article-editorial__next-arrow" aria-hidden="true">&nearr;</span>
            </a>
          {%- endif -%}
          {%- if blog.next_article -%}
            <a class="article-editorial__next-story" href="{{ blog.next_article.url }}">
              <span class="eyebrow">{{ 'blog.articles.older_story' | t }}</span>
              <strong>{{ blog.next_article.title | escape }}</strong>
              <span class="article-editorial__next-arrow" aria-hidden="true">&nearr;</span>
            </a>
          {%- endif -%}
        </div>
      </nav>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  .article-editorial {
    padding-block: clamp(28px, 4vw, 56px) clamp(64px, 8vw, 112px);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .article-editorial__progress {
    position: fixed;
    top: calc(var(--reader-top, 130px) - 24px);
    right: 0;
    left: 0;
    z-index: 89;
    height: 3px;
    pointer-events: none;
    background: var(--color-border);
  }

  .article-editorial__progress span {
    display: block;
    width: 100%;
    height: 100%;
    background: var(--color-accent);
    transform: scaleX(var(--reading-progress, 0));
    transform-origin: left;
  }

  .article-editorial__breadcrumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-utility);
    font-size: 11px;
  }

  .article-editorial__breadcrumbs > span {
    color: var(--color-muted);
  }

  .article-editorial__breadcrumbs a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .article-editorial__masthead {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.55fr);
    align-items: end;
    gap: clamp(24px, 5vw, 72px);
    padding-block: clamp(40px, 6vw, 80px) clamp(40px, 5vw, 72px);
  }

  .article-editorial__masthead > div:first-child {
    display: grid;
    gap: 22px;
  }

  .article-editorial h1 {
    max-width: 17ch;
    font-size: clamp(56px, 7.4vw, 112px);
    line-height: 0.96;
    letter-spacing: -0.06em;
  }

  .article-editorial__summary {
    display: grid;
    gap: 28px;
  }

  .article-editorial__excerpt {
    font-size: clamp(17px, 1.4vw, 20px);
    line-height: 1.6;
  }

  .article-editorial__meta {
    display: grid;
    gap: 10px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-utility);
    font-size: 11px;
    color: var(--color-muted);
  }

  .article-editorial__cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    max-height: 680px;
    overflow: hidden;
    border-radius: 8px;
    background: var(--color-border);
  }

  .article-editorial__cover-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: translateY(var(--editorial-image-y, 0px)) scale(var(--editorial-image-scale, 1));
  }

  .article-editorial.has-cover-pin .article-editorial__cover-stage {
    height: var(--reader-cover-stage-height);
  }

  .article-editorial.has-cover-pin .article-editorial__cover {
    position: sticky;
    top: var(--reader-top, 130px);
    height: var(--reader-cover-height);
    aspect-ratio: auto;
    clip-path: inset(0 var(--reader-cover-inset, 0%) round 8px);
  }

  .article-editorial.has-cover-pin .article-editorial__cover-label {
    left: calc(24px + var(--reader-cover-inset, 0%));
  }

  .article-editorial.article-has-motion .article-editorial__masthead > div:first-child {
    transform: translateY(var(--reader-title-y, 0px));
  }

  .article-editorial.article-has-motion .article-editorial__cover-label {
    opacity: var(--reader-caption-opacity, 1);
    transform: translateY(var(--reader-caption-y, 0px));
  }

  .article-editorial.article-has-motion .reader-reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 650ms ease, transform 750ms cubic-bezier(0.2, 0.72, 0.2, 1);
    transition-delay: var(--reader-reveal-delay, 0ms);
  }

  .article-editorial.article-has-motion .reader-reveal.is-reader-visible,
  .article-editorial.article-has-motion .reader-reveal:target,
  .article-editorial.article-has-motion .reader-reveal:focus-within {
    opacity: 1;
    transform: none;
  }

  .article-editorial.article-has-motion .reader-reveal:target,
  .article-editorial.article-has-motion .reader-reveal:focus-within {
    transition: none;
  }

  .article-editorial.article-has-motion .article-editorial__content h2.reader-reveal {
    position: relative;
  }

  .article-editorial.article-has-motion .article-editorial__content h2.reader-reveal::after {
    position: absolute;
    bottom: -12px;
    left: 0;
    width: 64px;
    height: 2px;
    background: var(--color-accent);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 650ms cubic-bezier(0.2, 0.72, 0.2, 1) 150ms;
  }

  .article-editorial.article-has-motion .article-editorial__content h2.is-reader-visible::after,
  .article-editorial.article-has-motion .article-editorial__content h2:target::after {
    transform: scaleX(1);
  }

  .article-editorial.article-has-motion blockquote.reader-reveal {
    position: relative;
    border-left-color: transparent;
  }

  .article-editorial.article-has-motion blockquote.reader-reveal::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -4px;
    width: 4px;
    background: var(--color-accent);
    content: "";
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 750ms cubic-bezier(0.2, 0.72, 0.2, 1) 100ms;
  }

  .article-editorial.article-has-motion blockquote.is-reader-visible::before {
    transform: scaleY(1);
  }

  .article-editorial__cover-label {
    position: absolute;
    bottom: 24px;
    left: 24px;
    max-width: calc(100% - 48px);
    padding: 10px 14px;
    border-radius: 4px;
    background: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-utility);
    font-size: 11px;
  }

  .article-editorial__reading-layout {
    display: grid;
    grid-template-columns: minmax(160px, 0.34fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 88px);
    max-width: 1160px;
    margin-inline: auto;
    padding-top: clamp(40px, 6vw, 88px);
  }

  .article-editorial__rail-inner {
    position: sticky;
    top: var(--reader-top, 130px);
    max-height: var(--reader-rail-height, calc(100svh - 154px));
    overflow-y: auto;
    scrollbar-width: thin;
    padding: 4px;
  }

  .article-editorial__back {
    align-items: center;
    gap: 12px;
    font-size: 12px;
  }

  .article-editorial__outline {
    margin-top: 36px;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-utility);
    font-size: 12px;
  }

  .article-editorial__outline summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding-block: 18px;
    cursor: pointer;
    list-style: none;
  }

  .article-editorial__outline summary::-webkit-details-marker {
    display: none;
  }

  .article-editorial__outline summary > span {
    font-size: 18px;
    transition: transform 180ms ease;
  }

  .article-editorial__outline[open] summary > span {
    transform: rotate(45deg);
  }

  .article-editorial__outline ol {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .article-editorial__outline a {
    display: block;
    padding: 10px 12px;
    border-left: 2px solid transparent;
    color: var(--color-muted);
    line-height: 1.5;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .article-editorial__outline a:hover,
  .article-editorial__outline a[aria-current="location"] {
    border-left-color: var(--color-accent);
    color: var(--color-foreground);
  }

  .article-editorial__outline a[aria-current="location"] {
    background: color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  .article-editorial__outline .is-subheading a {
    padding-left: 24px;
    font-size: 11px;
  }

  .article-editorial__reading {
    min-width: 0;
  }

  .article-editorial__content {
    color: var(--color-foreground);
    font-size: clamp(17px, 1.4vw, 19px);
    line-height: 1.85;
    overflow-wrap: anywhere;
  }

  .article-editorial__content > p:first-child {
    font-size: clamp(20px, 1.85vw, 26px);
    line-height: 1.65;
    letter-spacing: -0.015em;
  }

  .article-editorial__content h2,
  .article-editorial__content h3,
  .article-editorial__content h4 {
    margin-top: 1.7em;
    margin-bottom: 0.65em;
    line-height: 1.12;
    letter-spacing: -0.035em;
    scroll-margin-top: var(--reader-top, 130px);
  }

  .article-editorial__content h2 {
    font-size: clamp(30px, 3.2vw, 44px);
  }

  .article-editorial__content h3 {
    font-size: clamp(24px, 2.2vw, 32px);
  }

  .article-editorial__content h4 {
    font-size: 22px;
  }

  .article-editorial__content ul,
  .article-editorial__content ol {
    padding-left: 1.4em;
  }

  .article-editorial__content li + li {
    margin-top: 0.5em;
  }

  .article-editorial__content a {
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  .article-editorial__content blockquote {
    margin-inline: 0;
    padding: 8px 0 8px 28px;
    border-left: 4px solid var(--color-accent);
    font-family: var(--font-heading);
    font-size: clamp(24px, 2.8vw, 36px);
    line-height: 1.35;
    letter-spacing: -0.025em;
  }

  .article-editorial__content img,
  .article-editorial__content video {
    display: block;
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .article-editorial__content figure {
    margin-inline: 0;
  }

  .article-editorial__content figcaption {
    padding-top: 12px;
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 12px;
    line-height: 1.5;
  }

  .article-editorial__content th,
  .article-editorial__content td {
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .article-editorial__content pre {
    padding: 20px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    font-size: 14px;
  }

  .article-editorial__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    margin-top: 40px;
    font-family: var(--font-utility);
    font-size: 11px;
  }

  .article-editorial__tags > span {
    margin-right: 8px;
    color: var(--color-muted);
  }

  .article-editorial__tags a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 0;
    transition: background 180ms ease, color 180ms ease;
  }

  .article-editorial__tags a:hover,
  .article-editorial__tags a:focus-visible {
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  .article-editorial__endnote {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 20px;
    margin-top: 36px;
    padding-block: 24px;
    border-block: 1px solid var(--color-border);
    font-family: var(--font-utility);
    font-size: 12px;
  }

  .article-editorial__endnote .text-link {
    align-items: center;
    gap: 12px;
  }

  .article-editorial__comments {
    display: grid;
    gap: 24px;
    margin-top: 64px;
  }

  .article-editorial__comments > h2,
  .article-editorial__next h2 {
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.045em;
  }

  .article-editorial__comment {
    padding-block: 24px;
    border-top: 1px solid var(--color-border);
  }

  .article-editorial__comment footer {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 16px;
    font-family: var(--font-utility);
    font-size: 11px;
    color: var(--color-muted);
  }

  .comment-form.article-editorial__comment-form {
    gap: 28px;
    margin-top: 8px;
    padding: clamp(24px, 3vw, 40px);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-surface-text);
  }

  .article-editorial__comment-form > header {
    display: grid;
    gap: 14px;
  }

  .article-editorial__comment-form h3 {
    font-size: clamp(28px, 3.2vw, 42px);
    line-height: 1.05;
    letter-spacing: -0.035em;
  }

  .article-editorial__comment-form > header > p:last-child,
  .article-editorial__moderation {
    font-family: var(--font-utility);
    font-size: 12px;
    color: var(--color-muted);
  }

  .article-editorial__comment-fields {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }

  .article-editorial__comment-form label {
    display: flex;
    gap: 8px;
    font-family: var(--font-utility);
    font-size: 12px;
    font-weight: 500;
  }

  .article-editorial__comment-form .field__input {
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    font-size: 16px;
  }

  .article-editorial__comment-form .field__input:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
    border-bottom-color: var(--color-foreground);
  }

  .article-editorial__comment-form .field__input[aria-invalid="true"] {
    border-bottom-color: var(--color-accent-2);
  }

  .article-editorial__submit {
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    min-height: 58px;
    border-radius: 0;
  }

  .article-editorial__submit span {
    font-size: 24px;
  }

  .article-editorial__status {
    margin: 0;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .article-editorial__status.form-status--error {
    border-color: var(--color-accent-2);
    color: var(--color-foreground);
  }

  .article-editorial__next {
    margin-top: clamp(64px, 8vw, 112px);
  }

  .article-editorial__next > header {
    display: grid;
    gap: 18px;
    margin-bottom: 32px;
  }

  .article-editorial__next-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--color-border);
  }

  .article-editorial__next-story {
    position: relative;
    display: grid;
    align-content: start;
    gap: 24px;
    min-height: 200px;
    padding: 32px 72px 32px 0;
    border-bottom: 1px solid var(--color-border);
  }

  .article-editorial__next-story + .article-editorial__next-story {
    padding-left: 32px;
    border-left: 1px solid var(--color-border);
  }

  .article-editorial__next-story strong {
    max-width: 24ch;
    font-family: var(--font-heading);
    font-size: clamp(26px, 3vw, 40px);
    line-height: 1.1;
    letter-spacing: -0.035em;
  }

  .article-editorial__next-arrow {
    position: absolute;
    right: 16px;
    bottom: 32px;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 0;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-size: 24px;
    transition: transform 180ms ease;
  }

  .article-editorial__next-story:hover .article-editorial__next-arrow,
  .article-editorial__next-story:focus-visible .article-editorial__next-arrow {
    transform: rotate(45deg);
  }

  .no-js .article-editorial .reveal-item {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 989px) {
    .article-editorial.article-has-motion .reader-reveal {
      transform: translateY(14px);
    }

    .article-editorial.article-has-motion .reader-reveal.is-reader-visible,
    .article-editorial.article-has-motion .reader-reveal:target,
    .article-editorial.article-has-motion .reader-reveal:focus-within {
      transform: none;
    }

    .article-editorial__masthead,
    .article-editorial__reading-layout {
      grid-template-columns: 1fr;
    }

    .article-editorial h1 {
      font-size: clamp(48px, 9vw, 88px);
    }

    .article-editorial__summary {
      max-width: 52ch;
    }

    .article-editorial__meta {
      display: flex;
      flex-wrap: wrap;
      gap: 12px 24px;
    }

    .article-editorial__rail-inner {
      position: static;
      max-height: none;
      padding: 4px 0;
    }

    .article-editorial__outline {
      margin-top: 24px;
      border-bottom: 1px solid var(--color-border);
    }

    .article-editorial__outline ol {
      padding-bottom: 16px;
    }

    .article-editorial__cover-label {
      bottom: 16px;
      left: 16px;
      max-width: calc(100% - 32px);
      font-size: 10px;
    }
  }

  @media (max-width: 749px) {
    .article-editorial__cover {
      aspect-ratio: 4 / 3;
    }

    .article-editorial__cover-label {
      display: none;
    }

    .article-editorial__comment-fields,
    .article-editorial__next-grid {
      grid-template-columns: 1fr;
    }

    .article-editorial__next-story + .article-editorial__next-story {
      padding-left: 0;
      border-left: 0;
    }
  }

  @media (max-height: 479px) {
    .article-editorial__rail-inner {
      position: static;
      max-height: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .article-editorial__cover-image {
      transform: none;
    }

    .article-editorial.has-cover-pin .article-editorial__cover-stage {
      height: auto;
    }

    .article-editorial.has-cover-pin .article-editorial__cover {
      position: relative;
      height: auto;
      aspect-ratio: 16 / 9;
      clip-path: none;
    }

    .article-editorial.article-has-motion .reader-reveal {
      opacity: 1;
      transform: none;
    }

    .article-editorial.article-has-motion .article-editorial__masthead > div:first-child,
    .article-editorial.article-has-motion .article-editorial__cover-label {
      opacity: 1;
      transform: none;
    }
  }
{% endstylesheet %}

