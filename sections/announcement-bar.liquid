{%- liquid
  assign message_1 = section.settings.text | default: 'Free shipping over $100'
  assign message_2 = section.settings.text_2 | default: 'New arrivals just landed'
  assign message_3 = section.settings.text_3 | default: 'Easy returns within 30 days'
  assign message_count = 0
  if message_1 != blank
    assign message_count = message_count | plus: 1
  endif
  if message_2 != blank
    assign message_count = message_count | plus: 1
  endif
  if message_3 != blank
    assign message_count = message_count | plus: 1
  endif
  assign facebook_link = section.settings.facebook_link
  assign x_link = section.settings.x_link
  assign instagram_link = section.settings.instagram_link | default: settings.social_instagram_link
  assign youtube_link = section.settings.youtube_link | default: settings.social_youtube_link
  assign localization_form_id = 'AnnouncementLocalization-' | append: section.id
-%}

{%- if message_1 != blank or message_2 != blank or message_3 != blank -%}
  <aside
    id="AnnouncementBar-{{ section.id }}"
    class="announcement-bar"
    role="region"
    aria-label="{{ 'accessibility.announcement' | t }}"
    style="--announcement-background: {{ section.settings.color_background }}; --announcement-text: {{ section.settings.color_text }};"
    data-announcement-bar
  >
    <div class="announcement-bar__inner">
      {%- if section.settings.show_social_links -%}
        <nav class="announcement-bar__social" aria-label="{{ 'general.social.social_media' | t }}">
          {%- if facebook_link != blank -%}
            <a href="{{ facebook_link }}" target="_blank" rel="noopener nofollow" aria-label="{{ 'general.social.facebook' | t }}">
              {%- render 'icon-social', icon: 'facebook' -%}
            </a>
          {%- else -%}
            <span aria-hidden="true">{%- render 'icon-social', icon: 'facebook' -%}</span>
          {%- endif -%}
          {%- if x_link != blank -%}
            <a href="{{ x_link }}" target="_blank" rel="noopener nofollow" aria-label="{{ 'general.social.x' | t }}">
              {%- render 'icon-social', icon: 'x' -%}
            </a>
          {%- else -%}
            <span aria-hidden="true">{%- render 'icon-social', icon: 'x' -%}</span>
          {%- endif -%}
          {%- if instagram_link != blank -%}
            <a href="{{ instagram_link }}" target="_blank" rel="noopener nofollow" aria-label="{{ 'general.social.instagram' | t }}">
              {%- render 'icon-social', icon: 'instagram' -%}
            </a>
          {%- else -%}
            <span aria-hidden="true">{%- render 'icon-social', icon: 'instagram' -%}</span>
          {%- endif -%}
          {%- if youtube_link != blank -%}
            <a href="{{ youtube_link }}" target="_blank" rel="noopener nofollow" aria-label="{{ 'general.social.youtube' | t }}">
              {%- render 'icon-social', icon: 'youtube' -%}
            </a>
          {%- else -%}
            <span aria-hidden="true">{%- render 'icon-social', icon: 'youtube' -%}</span>
          {%- endif -%}
        </nav>
      {%- endif -%}

      <div class="announcement-bar__slider" data-announcement-slider>
        <button
          class="announcement-bar__arrow"
          type="button"
          aria-label="{{ 'accessibility.previous_announcement' | t }}"
          data-announcement-previous
          {% if message_count <= 1 %}disabled{% endif %}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m14.5 5-7 7 7 7M8 12h9" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
          </svg>
        </button>

        {%- assign slide_index = 0 -%}
        {%- if section.settings.link != blank -%}
          <a href="{{ section.settings.link }}" class="announcement-bar__link announcement-bar__items" aria-live="polite">
            {%- if message_1 != blank -%}
              <span class="announcement-bar__message{% if slide_index == 0 %} announcement-bar__message--first is-active{% endif %}" data-announcement-slide{% unless slide_index == 0 %} hidden{% endunless %}>{{ message_1 }}</span>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
            {%- if message_2 != blank -%}
              <span class="announcement-bar__message{% if slide_index == 0 %} announcement-bar__message--first is-active{% endif %}" data-announcement-slide{% unless slide_index == 0 %} hidden{% endunless %}>{{ message_2 }}</span>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
            {%- if message_3 != blank -%}
              <span class="announcement-bar__message{% if slide_index == 0 %} announcement-bar__message--first is-active{% endif %}" data-announcement-slide{% unless slide_index == 0 %} hidden{% endunless %}>{{ message_3 }}</span>
            {%- endif -%}
          </a>
        {%- else -%}
          <p class="announcement-bar__items" aria-live="polite">
            {%- if message_1 != blank -%}
              <span class="announcement-bar__message{% if slide_index == 0 %} announcement-bar__message--first is-active{% endif %}" data-announcement-slide{% unless slide_index == 0 %} hidden{% endunless %}>{{ message_1 }}</span>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
            {%- if message_2 != blank -%}
              <span class="announcement-bar__message{% if slide_index == 0 %} announcement-bar__message--first is-active{% endif %}" data-announcement-slide{% unless slide_index == 0 %} hidden{% endunless %}>{{ message_2 }}</span>
              {%- assign slide_index = slide_index | plus: 1 -%}
            {%- endif -%}
            {%- if message_3 != blank -%}
              <span class="announcement-bar__message{% if slide_index == 0 %} announcement-bar__message--first is-active{% endif %}" data-announcement-slide{% unless slide_index == 0 %} hidden{% endunless %}>{{ message_3 }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        <button
          class="announcement-bar__arrow"
          type="button"
          aria-label="{{ 'accessibility.next_announcement' | t }}"
          data-announcement-next
          {% if message_count <= 1 %}disabled{% endif %}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m9.5 5 7 7-7 7M16 12H7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6"/>
          </svg>
        </button>
      </div>

      {%- if section.settings.show_localization -%}
        <div class="announcement-bar__localization">
          {%- form 'localization', id: localization_form_id, class: 'localization-form' -%}
            <div class="announcement-bar__selector announcement-bar__selector--language">
              <svg class="announcement-bar__selector-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.4"/>
                <path d="M3 12h18M12 3c2.5 2.5 3.8 5.5 3.8 9S14.5 18.5 12 21c-2.5-2.5-3.8-5.5-3.8-9S9.5 5.5 12 3Z" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              <label class="visually-hidden" for="{{ localization_form_id }}-language">{{ 'localization.language_label' | t }}</label>
              <select id="{{ localization_form_id }}-language" name="locale_code" class="localization-form__select" onchange="this.form.submit()">
                {%- for language in localization.available_languages -%}
                  <option value="{{ language.iso_code }}"{% if language.iso_code == localization.language.iso_code %} selected{% endif %}>
                    {{ language.endonym_name | capitalize }}
                  </option>
                {%- endfor -%}
              </select>
              <svg class="announcement-bar__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3"/>
              </svg>
            </div>

            <div class="announcement-bar__selector announcement-bar__selector--country">
              <svg class="announcement-bar__selector-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <ellipse cx="9" cy="7" rx="5" ry="2.5" fill="none" stroke="currentColor" stroke-width="1.4"/>
                <path d="M4 7v4c0 1.4 2.2 2.5 5 2.5s5-1.1 5-2.5V7M4 11v4c0 1.4 2.2 2.5 5 2.5.8 0 1.5-.1 2.2-.2" fill="none" stroke="currentColor" stroke-width="1.4"/>
                <ellipse cx="16" cy="15" rx="4" ry="2" fill="none" stroke="currentColor" stroke-width="1.4"/>
                <path d="M12 15v3.5c0 1.1 1.8 2 4 2s4-.9 4-2V15" fill="none" stroke="currentColor" stroke-width="1.4"/>
              </svg>
              <label class="visually-hidden" for="{{ localization_form_id }}-country">{{ 'localization.country_label' | t }}</label>
              <select id="{{ localization_form_id }}-country" name="country_code" class="localization-form__select" onchange="this.form.submit()">
                {%- for country in localization.available_countries -%}
                  <option value="{{ country.iso_code }}"{% if country.iso_code == localization.country.iso_code %} selected{% endif %}>
                    {{ country.name }} ({{ country.currency.iso_code }} {{ country.currency.symbol }})
                  </option>
                {%- endfor -%}
              </select>
              <svg class="announcement-bar__chevron" viewBox="0 0 12 8" aria-hidden="true" focusable="false">
                <path d="m1 1.5 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3"/>
              </svg>
            </div>
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>
  </aside>
{%- endif -%}

{% javascript %}
  (() => {
    const initialize = (root) => {
      if (!root || root.dataset.announcementInitialized === 'true') return;

      const slides = Array.from(root.querySelectorAll('[data-announcement-slide]'));
      const previous = root.querySelector('[data-announcement-previous]');
      const next = root.querySelector('[data-announcement-next]');
      if (slides.length < 2 || !previous || !next) return;

      root.dataset.announcementInitialized = 'true';
      let activeIndex = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
      let timer;

      const show = (index) => {
        activeIndex = (index + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          const isActive = slideIndex === activeIndex;
          slide.hidden = !isActive;
          slide.classList.toggle('is-active', isActive);
        });
      };

      const stop = () => window.clearInterval(timer);
      const start = () => {
        stop();
        timer = window.setInterval(() => show(activeIndex + 1), 5000);
      };

      previous.addEventListener('click', () => {
        show(activeIndex - 1);
        start();
      });
      next.addEventListener('click', () => {
        show(activeIndex + 1);
        start();
      });
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);
      start();
    };

    const initializeAll = (scope = document) => {
      if (scope.matches?.('[data-announcement-bar]')) initialize(scope);
      scope.querySelectorAll?.('[data-announcement-bar]').forEach(initialize);
    };

    initializeAll();
    document.addEventListener('shopify:section:load', (event) => initializeAll(event.target));
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.announcement_bar.s001",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:sections.announcement_bar.s002",
      "default": "Free shipping over $100"
    },
    {
      "type": "text",
      "id": "text_2",
      "label": "t:sections.announcement_bar.s003",
      "default": "New arrivals just landed"
    },
    {
      "type": "text",
      "id": "text_3",
      "label": "t:sections.announcement_bar.s004",
      "default": "Easy returns within 30 days"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.announcement_bar.s005"
    },
    {
      "type": "checkbox",
      "id": "show_social_links",
      "label": "t:sections.announcement_bar.s008",
      "default": true
    },
    {
      "type": "url",
      "id": "facebook_link",
      "label": "t:sections.announcement_bar.s009"
    },
    {
      "type": "url",
      "id": "x_link",
      "label": "t:sections.announcement_bar.s010"
    },
    {
      "type": "url",
      "id": "instagram_link",
      "label": "t:sections.announcement_bar.s011"
    },
    {
      "type": "url",
      "id": "youtube_link",
      "label": "t:sections.announcement_bar.s012"
    },
    {
