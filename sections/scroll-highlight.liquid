<scroll-highlight
  class="scroll-highlight"
  data-scroll-length="{{ section.settings.scroll_length }}"
  data-sticky-offset="{{ section.settings.sticky_offset }}"
  style="--highlight-background: {{ section.settings.background }}; --highlight-color: {{ section.settings.highlight_color }}; --highlight-muted: {{ section.settings.muted_color }}; --highlight-font-size: {{ section.settings.font_size }}px; --highlight-mobile-font-size: {{ section.settings.mobile_font_size }}px; --highlight-width: {{ section.settings.content_width }}px;"
>
  <div class="scroll-highlight__panel">
    <div class="scroll-highlight__content">
      {%- if section.settings.kicker != blank -%}
        <p class="scroll-highlight__kicker">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <h2 class="scroll-highlight__text">
          <span class="visually-hidden" data-highlight-source>{{ section.settings.text | escape }}</span>
          <span data-highlight-visual aria-hidden="true">{{ section.settings.text | escape }}</span>
        </h2>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="scroll-highlight__link" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</scroll-highlight>

{% stylesheet %}
  .scroll-highlight {
    display: block;
    position: relative;
    background: var(--highlight-background);
    color: var(--highlight-color);
    --highlight-top: 0px;
    --highlight-viewport: 100svh;
  }

  .scroll-highlight.is-enhanced {
    min-height: calc(var(--highlight-panel-height) + var(--highlight-distance));
  }

  .scroll-highlight__panel {
    display: grid;
    align-items: center;
    min-height: calc(var(--highlight-viewport) - var(--highlight-top));
    padding: clamp(32px, 6svh, 72px) 24px;
    background: var(--highlight-background);
  }

  .scroll-highlight.is-enhanced .scroll-highlight__panel {
    position: sticky;
    top: var(--highlight-top);
  }

  .scroll-highlight__content {
    display: grid;
    justify-items: center;
    gap: clamp(28px, 3vw, 44px);
    width: min(100%, var(--highlight-width));
    margin-inline: auto;
    text-align: center;
  }

  .scroll-highlight__kicker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
  }

  .scroll-highlight__kicker::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }

  .scroll-highlight__text {
    width: 100%;
    margin: 0;
    font-family: var(--font-body);
    font-size: clamp(32px, 4.4vw, var(--highlight-font-size));
    font-weight: 400;
    line-height: 1.02;
    letter-spacing: -0.055em;
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  [data-highlight-visual] {
    white-space: pre-line;
  }

  .scroll-highlight__word {
    display: inline-block;
    max-width: 100%;
    white-space: normal;
  }

  .scroll-highlight__letter {
    color: var(--highlight-color);
    color: color-mix(in srgb, var(--highlight-color) var(--letter-progress, 100%), var(--highlight-muted));
  }

  .scroll-highlight__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 184px;
    min-height: 58px;
    padding: 14px 30px;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    border-radius: 999px;
    font-size: 16px;
    line-height: 1.4;
    transition: background 160ms ease, color 160ms ease;
  }

  .scroll-highlight__link:hover {
    background: var(--highlight-color);
    color: var(--highlight-background);
  }

  @media (max-width: 749px) {
    .scroll-highlight__panel {
      padding: 40px 20px;
    }

    .scroll-highlight__text {
      font-size: var(--highlight-mobile-font-size);
      line-height: 1.08;
      letter-spacing: -0.045em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-highlight.is-enhanced {
      min-height: auto;
    }

    .scroll-highlight.is-enhanced .scroll-highlight__panel {
      position: static;
    }

    .scroll-highlight__letter {
      color: var(--highlight-color);
    }

    .scroll-highlight__link {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('scroll-highlight')) {
    customElements.define('scroll-highlight', class extends HTMLElement {
      connectedCallback() {
        this.connectionFrame = requestAnimationFrame(() => {
          this.connectionFrame = null;
          if (this.isConnected) this.initialize();
        });
      }

      initialize() {
        const source = this.querySelector('[data-highlight-source]');
        const visual = this.querySelector('[data-highlight-visual]');
        this.panel = this.querySelector('.scroll-highlight__panel');
        if (!source || !visual || !this.panel) return;

        this.letters = [];
        this.progress = undefined;
        const fragment = document.createDocumentFragment();
        const segmenter = typeof Intl.Segmenter === 'function'
          ? new Intl.Segmenter(document.documentElement.lang || 'en', { granularity: 'grapheme' })
          : null;

        source.textContent.split(/(\s+)/u).forEach((token) => {
          if (!token) return;
          if (/^\s+$/u.test(token)) {
            fragment.append(document.createTextNode(token));
            return;
          }
          const word = document.createElement('span');
          word.className = 'scroll-highlight__word';
          const characters = segmenter
            ? Array.from(segmenter.segment(token), (part) => part.segment)
            : Array.from(token);
          characters.forEach((character) => {
            const letter = document.createElement('span');
            letter.className = 'scroll-highlight__letter';
            letter.textContent = character;
            word.append(letter);
            this.letters.push(letter);
          });
          fragment.append(word);
        });
        visual.replaceChildren(fragment);
        if (!this.letters.length) return;

        this.controller = new AbortController();
        const options = { signal: this.controller.signal };
        this.motion = window.matchMedia('(prefers-reduced-motion: reduce)');
        this.schedule = () => {
          if (this.frame) return;
          this.frame = requestAnimationFrame(() => {
            this.frame = null;
            this.update();
          });
        };
        this.measure = this.measure.bind(this);
        window.addEventListener('scroll', this.schedule, { ...options, passive: true });
        window.addEventListener('resize', this.measure, options);
        this.motion.addEventListener('change', this.measure, options);
        document.addEventListener('shopify:section:reorder', this.schedule, options);
        this.resizeObserver = new ResizeObserver(this.measure);
        this.resizeObserver.observe(this.panel);
        document.querySelectorAll('.site-header, .announcement-bar').forEach((header) => {
          this.resizeObserver.observe(header);
        });
        document.fonts?.ready.then(() => {
          if (this.isConnected) this.measure();
        });
        this.measure();
      }

      measure() {
        if (!this.isConnected) return;
        const viewport = document.documentElement.clientHeight;
        let top = Number(this.dataset.stickyOffset) || 0;
        document.querySelectorAll('.site-header, .announcement-bar').forEach((header) => {
          const position = getComputedStyle(header).position;
          if (position === 'fixed' || position === 'sticky') {
            top = Math.max(top, header.getBoundingClientRect().bottom);
          }
        });
        this.top = Math.min(Math.max(0, top), Math.max(0, viewport - 1));
        this.style.setProperty('--highlight-top', `${this.top}px`);
        this.style.setProperty('--highlight-viewport', `${viewport}px`);
        const panelHeight = this.panel.getBoundingClientRect().height;
        this.distance = viewport * (Number(this.dataset.scrollLength) || 200) / 100;
        this.style.setProperty('--highlight-panel-height', `${panelHeight}px`);
        this.style.setProperty('--highlight-distance', `${this.distance}px`);
        this.enhanced = !this.motion.matches && panelHeight <= viewport - this.top + 1;
        this.classList.toggle('is-enhanced', this.enhanced);
        this.update();
      }

      update() {
        if (!this.isConnected) return;
        const progress = this.enhanced
          ? Math.min(1, Math.max(0, (this.top - this.getBoundingClientRect().top) / this.distance) / 0.9)
          : 1;
        if (progress === this.progress) return;
        this.progress = progress;
        const fade = Math.min(12, this.letters.length);
        const revealed = progress * (this.letters.length + fade);
        this.letters.forEach((letter, index) => {
          const amount = Math.min(1, Math.max(0, (revealed - index) / fade));
          if (amount === letter.highlightAmount) return;
          letter.highlightAmount = amount;
          letter.style.setProperty('--letter-progress', `${amount * 100}%`);
        });
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.resizeObserver?.disconnect();
        if (this.connectionFrame) cancelAnimationFrame(this.connectionFrame);
        if (this.frame) cancelAnimationFrame(this.frame);
        this.connectionFrame = null;
        this.frame = null;
      }
    });
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.scroll_highlight.name",
  "tag": "section",
  "class": "scroll-highlight-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.scroll_highlight.kicker",
      "default": "t:sections.scroll_highlight.default_kicker"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.scroll_highlight.text",
      "default": "t:sections.scroll_highlight.default_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.scroll_highlight.button_label",
      "default": "t:sections.scroll_highlight.default_button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.scroll_highlight.button_link"
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "t:sections.scroll_highlight.scroll_length",
      "info": "t:sections.scroll_highlight.scroll_info",
      "min": 100,
      "max": 500,
      "step": 25,
      "unit": "vh",
      "default": 200
    },
    {
      "type": "range",
      "id": "sticky_offset",
      "label": "t:sections.scroll_highlight.sticky_offset",
      "info": "t:sections.scroll_highlight.offset_info",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "t:sections.scroll_highlight.font_size",
      "min": 32,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "t:sections.scroll_highlight.mobile_font_size",
      "min": 20,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "content_width",
      "label": "t:sections.scroll_highlight.content_width",
      "min": 600,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "color",
      "id": "background",
      "label": "t:sections.scroll_highlight.background",
      "default": "#faf5f1"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "t:sections.scroll_highlight.muted_color",
      "default": "#e5dfdc"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "t:sections.scroll_highlight.highlight_color",
      "default": "#332321"
    }
  ],
  "presets": [
    {
      "name": "t:sections.scroll_highlight.name"
    }
  ]
}
{% endschema %}
