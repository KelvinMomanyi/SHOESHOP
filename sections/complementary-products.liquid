<section class="complementary-products section-band color-paper" data-recommendations-container>
  <div class="page-width">
    <div class="section-heading reveal-item">
      <p class="eyebrow">{{ section.settings.kicker }}</p>
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <product-recommendations
      class="product-recommendations__list"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}&intent=complementary"
      data-loaded="{% if recommendations.performed %}true{% else %}false{% endif %}"
      data-hide-when-empty="true"
    >
      {%- liquid
        assign complementary_products = blank
        if recommendations.performed and recommendations.products_count > 0
          assign complementary_products = recommendations.products | reject: 'id', product.id
        endif
        if complementary_products == blank and section.settings.fallback_products != blank
          assign complementary_products = section.settings.fallback_products | reject: 'id', product.id
        endif
      -%}
      {%- if complementary_products != blank -%}
        <div class="product-grid">
          {%- for recommendation in complementary_products limit: section.settings.products_to_show -%}
            {%- render 'product-card', product: recommendation, loading: 'lazy' -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </product-recommendations>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.complementary_products.s001",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.complementary_products.s002",
      "default": "Pairs with"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.complementary_products.s003",
      "default": "Complete the set"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "t:sections.complementary_products.s004",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 4
    },
    {
      "type": "product_list",
      "id": "fallback_products",
      "label": "t:sections.complementary_products.s005",
      "info": "t:sections.complementary_products.s006"
    }
  ],
  "presets": [
    {
      "name": "t:sections.complementary_products.s007"
    }
  ]
}
{% endschema %}
