{%- liquid
  assign top_direction = 'normal'
  assign bottom_direction = 'reverse'
  if section.settings.top_direction == 'right'
    assign top_direction = 'reverse'
    assign bottom_direction = 'normal'
  endif
  assign image_loading = 'lazy'
  unless section.index > 2
    assign image_loading = 'eager'
  endunless
-%}

{%- capture image_sizes -%}(max-width: 749px) {{ section.settings.mobile_logo_width }}px, {{ section.settings.logo_width }}px{%- endcapture -%}

{% style %}
  #shopify-section-{{ section.id }} .logo-marquee {
    --marquee-background: {{ section.settings.background }};
    --marquee-top-background: {{ section.settings.top_background }};
    --marquee-bottom-background: {{ section.settings.bottom_background }};
    --marquee-bottom-opacity: {{ section.settings.bottom_opacity | divided_by: 100.0 }};
    --marquee-angle: {{ section.settings.angle }}deg;
    --marquee-tilt-space: {{ section.settings.angle | times: 1.1 }}vw;
    --marquee-top-direction: {{ top_direction }};
    --marquee-bottom-direction: {{ bottom_direction }};
    --marquee-desktop-logo-width: {{ section.settings.logo_width }}px;
    --marquee-mobile-logo-width: {{ section.settings.mobile_logo_width }}px;
    --marquee-desktop-logo-height: {{ section.settings.logo_height }}px;
    --marquee-mobile-logo-height: {{ section.settings.mobile_logo_height }}px;
    --marquee-desktop-band-height: {{ section.settings.band_height }}px;
    --marquee-mobile-band-height: {{ section.settings.mobile_band_height }}px;
    --marquee-desktop-gap: {{ section.settings.logo_gap }}px;
    --marquee-mobile-gap: {{ section.settings.mobile_logo_gap }}px;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{% endstyle %}

<treadora-logo-marquee
  class="logo-marquee"
  data-speed="{{ section.settings.speed }}"
  data-paused="false"
  data-pause-on-hover="{{ section.settings.pause_on_hover }}"
  data-pause-label="{{ 'sections.logo_marquee.pause' | t | escape }}"
  data-resume-label="{{ 'sections.logo_marquee.resume' | t | escape }}"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="logo-marquee__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  <button class="logo-marquee__pause" type="button" aria-label="{{ 'sections.logo_marquee.pause' | t | escape }}" aria-pressed="false">
    <svg class="logo-marquee__pause-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="M6 4v12M14 4v12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
    <svg class="logo-marquee__play-icon" viewBox="0 0 20 20" width="20" height="20" aria-hidden="true" focusable="false">
      <path d="m7 4 9 6-9 6Z" fill="currentColor"/>
    </svg>
  </button>
  <div class="logo-marquee__stage">
    {%- for row_index in (1..2) -%}
      <div class="logo-marquee__band{% if row_index == 1 %} logo-marquee__band--top{% else %} logo-marquee__band--bottom{% endif %}">
        <div class="logo-marquee__track">
          <div class="logo-marquee__group" data-marquee-group>
            <div class="logo-marquee__set" data-marquee-set role="list">
              {%- for block in section.blocks -%}
                {%- liquid
                  assign placeholder_label = 'sections.logo_marquee.placeholder' | t: number: forloop.index
                  assign logo_alt = block.settings.alt_text | default: block.settings.image.alt | default: placeholder_label
                -%}
                <div class="logo-marquee__item" role="listitem"{% if row_index == 1 %} {{ block.shopify_attributes }}{% endif %}>
                  {%- capture logo_markup -%}
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 640
                        | image_tag:
                          widths: '120, 180, 240, 320, 480, 640',
                          sizes: image_sizes,
                          loading: image_loading,
                          alt: logo_alt,
                          class: 'logo-marquee__image'
                      }}
                    {%- else -%}
                      <span class="logo-marquee__placeholder">{{ logo_alt | escape }}</span>
                    {%- endif -%}
                  {%- endcapture -%}
                  {%- if block.settings.link != blank -%}
                    <a class="logo-marquee__link" href="{{ block.settings.link | escape }}">{{ logo_markup }}</a>
                  {%- else -%}
                    {{ logo_markup }}
                  {%- endif -%}
                </div>
              {%- else -%}
                {%- for placeholder_index in (1..6) -%}
                  <div class="logo-marquee__item" role="listitem">
                    <span class="logo-marquee__placeholder">{{ 'sections.logo_marquee.placeholder' | t: number: placeholder_index }}</span>
                  </div>
                {%- endfor -%}
              {%- endfor -%}
            </div>
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>
</treadora-logo-marquee>

{% stylesheet %}
  .logo-marquee {
    --marquee-logo-width: var(--marquee-desktop-logo-width);
    --marquee-logo-height: var(--marquee-desktop-logo-height);
    --marquee-band-height: var(--marquee-desktop-band-height);
    --marquee-gap: var(--marquee-desktop-gap);
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    background: var(--marquee-background);
    color: var(--color-foreground, #171717);
  }

  .logo-marquee__heading {
    margin: 0 60px 28px;
    text-align: center;
  }

  .logo-marquee__stage {
    padding-block: var(--marquee-tilt-space);
  }

  .logo-marquee__band {
    position: relative;
    width: 110%;
    height: var(--marquee-band-height);
    margin-inline-start: -5%;
    overflow: hidden;
    direction: ltr;
  }

  .logo-marquee__band--top {
    z-index: 2;
    background: var(--marquee-top-background);
    transform: rotate(calc(var(--marquee-angle) * -1));
  }

  .logo-marquee__band--bottom {
    z-index: 1;
    background: var(--marquee-bottom-background);
    transform: rotate(var(--marquee-angle));
  }

  .logo-marquee__track,
  .logo-marquee__group,
  .logo-marquee__set {
    display: flex;
    width: max-content;
    height: 100%;
    flex-shrink: 0;
    align-items: center;
  }

  .logo-marquee__track {
    animation: treadora-logo-marquee var(--marquee-duration, 30s) linear infinite;
    animation-play-state: paused;
    will-change: transform;
  }

  .logo-marquee__band--top .logo-marquee__track {
    animation-direction: var(--marquee-top-direction);
  }

  .logo-marquee__band--bottom .logo-marquee__track {
    animation-direction: var(--marquee-bottom-direction);
    animation-delay: calc(var(--marquee-duration, 30s) * -0.35);
  }

  .logo-marquee__set {
    gap: var(--marquee-gap);
    padding-inline-end: var(--marquee-gap);
  }

  .logo-marquee__item {
    display: flex;
    width: var(--marquee-logo-width);
    height: min(var(--marquee-logo-height), calc(var(--marquee-band-height) - 24px));
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
  }

  .logo-marquee__link,
  .logo-marquee__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .logo-marquee__link {
    display: grid;
    place-items: center;
  }

  .logo-marquee__image {
    object-fit: contain;
  }

  .logo-marquee__band--bottom .logo-marquee__item {
    opacity: var(--marquee-bottom-opacity);
  }

  .logo-marquee__placeholder {
    font-family: var(--font-heading, sans-serif);
    font-size: clamp(20px, 3vw, 44px);
    font-weight: 700;
    line-height: 1;
    white-space: nowrap;
  }

  .logo-marquee__pause {
    position: absolute;
    z-index: 3;
    top: 10px;
    right: 16px;
    display: none;
    width: 36px;
    height: 36px;
    padding: 0;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 0;
    background: var(--marquee-background);
    color: inherit;
    cursor: pointer;
  }

  .logo-marquee__play-icon {
    display: none;
  }

  .logo-marquee[data-ready] .logo-marquee__pause {
    display: grid;
  }

  .logo-marquee[data-ready] .logo-marquee__track {
    animation-play-state: running;
  }

  .logo-marquee[data-paused='true'] .logo-marquee__track,
  .logo-marquee[data-editor-paused] .logo-marquee__track,
  .logo-marquee:has(.logo-marquee__band:focus-within) .logo-marquee__track,
  .logo-marquee[data-pause-on-hover='true']:has(.logo-marquee__band:hover) .logo-marquee__track {
    animation-play-state: paused;
  }

  .logo-marquee[data-paused='true'] .logo-marquee__pause-icon {
    display: none;
  }

  .logo-marquee[data-paused='true'] .logo-marquee__play-icon {
    display: block;
  }

  .logo-marquee:not([data-ready]) .logo-marquee__band {
    overflow-x: auto;
  }

  @keyframes treadora-logo-marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  @media (max-width: 749px) {
    .logo-marquee {
      --marquee-logo-width: var(--marquee-mobile-logo-width);
      --marquee-logo-height: var(--marquee-mobile-logo-height);
      --marquee-band-height: var(--marquee-mobile-band-height);
      --marquee-gap: var(--marquee-mobile-gap);
    }

    .logo-marquee__heading {
      margin-inline: 48px;
      font-size: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-marquee__stage {
      padding-block: 0;
    }

    .logo-marquee__band {
      width: 100%;
      height: auto;
      margin-inline-start: 0;
      padding-block: 24px;
      transform: none;
    }

    .logo-marquee__track,
    .logo-marquee__group,
    .logo-marquee__set {
      width: 100%;
      height: auto;
    }

    .logo-marquee__track {
      animation: none;
      will-change: auto;
    }

    .logo-marquee__set {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0 16px;
    }

    .logo-marquee [data-marquee-copy],
    .logo-marquee[data-ready] .logo-marquee__pause {
      display: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('treadora-logo-marquee')) {
    class TreadoraLogoMarquee extends HTMLElement {
      connectedCallback() {
        this.controller?.abort();
        this.resizeObserver?.disconnect();
        this.controller = new AbortController();
        const options = { signal: this.controller.signal };
        this.pauseButton = this.querySelector('.logo-marquee__pause');
        this.pauseButton?.addEventListener('click', () => {
          this.dataset.paused = String(this.dataset.paused !== 'true');
          this.updatePauseButton();
        }, options);
        document.addEventListener('shopify:block:select', (event) => {
          if (this.contains(event.target)) this.dataset.editorPaused = '';
        }, options);
        document.addEventListener('shopify:block:deselect', (event) => {
          if (this.contains(event.target)) delete this.dataset.editorPaused;
        }, options);
        this.updatePauseButton();
        this.rebuild();
        this.resizeObserver = new ResizeObserver(() => {
          cancelAnimationFrame(this.resizeFrame);
          this.resizeFrame = requestAnimationFrame(() => this.rebuild());
        });
        this.resizeObserver.observe(this);
      }

      updatePauseButton() {
        if (!this.pauseButton) return;
        const paused = this.dataset.paused === 'true';
        this.pauseButton.setAttribute('aria-pressed', String(paused));
        this.pauseButton.setAttribute('aria-label', paused ? this.dataset.resumeLabel : this.dataset.pauseLabel);
      }

      createCopy(element) {
        const copy = element.cloneNode(true);
        copy.dataset.marqueeCopy = '';
        copy.setAttribute('aria-hidden', 'true');
        for (const node of [copy, ...copy.querySelectorAll('*')]) {
          node.removeAttribute('id');
          node.removeAttribute('data-shopify-editor-block');
          if (node.matches('a, button, input, select, textarea, [tabindex]')) node.setAttribute('tabindex', '-1');
        }
        return copy;
      }

      rebuild() {
        const speed = Math.max(1, Number(this.dataset.speed) || 40);
        for (const band of this.querySelectorAll('.logo-marquee__band')) {
          const track = band.querySelector('.logo-marquee__track');
          const group = track?.querySelector('[data-marquee-group]');
          const source = group?.querySelector('[data-marquee-set]');
          if (!source) continue;
          track.querySelectorAll(':scope > [data-marquee-copy]').forEach(copy => copy.remove());
          group.querySelectorAll(':scope > [data-marquee-copy]').forEach(copy => copy.remove());
          const layoutWidth = source.offsetWidth;
          if (!layoutWidth) continue;
          const repeats = Math.max(1, Math.ceil(band.clientWidth / layoutWidth));
          for (let repeat = 1; repeat < repeats; repeat += 1) group.append(this.createCopy(source));
          track.append(this.createCopy(group));
          track.style.setProperty('--marquee-duration', `${group.offsetWidth / speed}s`);
        }
        this.dataset.ready = '';
      }

      disconnectedCallback() {
        this.controller?.abort();
        this.resizeObserver?.disconnect();
        cancelAnimationFrame(this.resizeFrame);
      }
    }

    customElements.define('treadora-logo-marquee', TreadoraLogoMarquee);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.logo_marquee.name",
  "tag": "section",
  "disabled_on": { "groups": ["header", "footer"] },
  "max_blocks": 20,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:sections.logo_marquee.heading" },
    { "type": "range", "id": "speed", "label": "t:sections.logo_marquee.speed", "info": "t:sections.logo_marquee.speed_info", "min": 10, "max": 100, "step": 5, "default": 40 },
    { "type": "select", "id": "top_direction", "label": "t:sections.logo_marquee.direction", "info": "t:sections.logo_marquee.direction_info", "options": [{ "value": "left", "label": "t:sections.logo_marquee.left" }, { "value": "right", "label": "t:sections.logo_marquee.right" }], "default": "left" },
    { "type": "range", "id": "angle", "label": "t:sections.logo_marquee.angle", "min": 0, "max": 8, "step": 1, "unit": "deg", "default": 3 },
    { "type": "range", "id": "logo_width", "label": "t:sections.logo_marquee.logo_width", "min": 80, "max": 320, "step": 10, "unit": "px", "default": 240 },
    { "type": "range", "id": "mobile_logo_width", "label": "t:sections.logo_marquee.mobile_logo_width", "min": 60, "max": 200, "step": 10, "unit": "px", "default": 140 },
    { "type": "range", "id": "logo_height", "label": "t:sections.logo_marquee.logo_height", "min": 30, "max": 120, "step": 5, "unit": "px", "default": 80 },
    { "type": "range", "id": "mobile_logo_height", "label": "t:sections.logo_marquee.mobile_logo_height", "min": 24, "max": 80, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "band_height", "label": "t:sections.logo_marquee.band_height", "min": 80, "max": 240, "step": 10, "unit": "px", "default": 160 },
    { "type": "range", "id": "mobile_band_height", "label": "t:sections.logo_marquee.mobile_band_height", "min": 64, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "logo_gap", "label": "t:sections.logo_marquee.logo_gap", "min": 0, "max": 200, "step": 10, "unit": "px", "default": 120 },
    { "type": "range", "id": "mobile_logo_gap", "label": "t:sections.logo_marquee.mobile_logo_gap", "min": 0, "max": 100, "step": 4, "unit": "px", "default": 40 },
    { "type": "color", "id": "background", "label": "t:sections.logo_marquee.background", "default": "#ffffff" },
    { "type": "color", "id": "top_background", "label": "t:sections.logo_marquee.top_background", "default": "#ffe88b" },
    { "type": "color", "id": "bottom_background", "label": "t:sections.logo_marquee.bottom_background", "default": "#f7f7f7" },
    { "type": "range", "id": "bottom_opacity", "label": "t:sections.logo_marquee.bottom_opacity", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 25 },
    { "type": "checkbox", "id": "pause_on_hover", "label": "t:sections.logo_marquee.pause_on_hover", "default": true },
    { "type": "range", "id": "padding_top", "label": "t:sections.logo_marquee.padding_top", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "t:sections.logo_marquee.padding_bottom", "min": 0, "max": 120, "step": 4, "unit": "px", "default": 20 }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:sections.logo_marquee.logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "t:sections.logo_marquee.image", "info": "t:sections.logo_marquee.image_info" },
        { "type": "text", "id": "alt_text", "label": "t:sections.logo_marquee.alt_text" },
        { "type": "url", "id": "link", "label": "t:sections.logo_marquee.link" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.logo_marquee.name", "blocks": [{ "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" }] }]
}
{% endschema %}
