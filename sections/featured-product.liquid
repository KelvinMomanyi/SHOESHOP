{%- liquid
  assign featured_product = section.settings.product
  assign current_variant = featured_product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign quantity_min = current_variant.quantity_rule.min | default: 1
  assign quantity_increment = current_variant.quantity_rule.increment | default: 1
  assign quantity_max = current_variant.quantity_rule.max
-%}

<section class="featured-product product product--featured page-width" data-section-id="{{ section.id }}" data-product-url="{{ featured_product.url }}">
  <div class="product__media-gallery">
    {%- if featured_product.media.size > 0 -%}
      {%- for media in featured_product.media -%}
        {%- liquid
          assign media_loading = 'lazy'
          assign media_alt = media.alt | escape
          if forloop.first
            assign media_loading = 'eager'
          endif
        -%}
        <div class="product-media media-frame" data-media-id="{{ section.id }}-{{ media.id }}">
          {%- case media.media_type -%}
            {%- when 'image' -%}
              {{
                media.preview_image
                | image_url: width: 1600
                | image_tag:
                  widths: '360, 533, 720, 940, 1200, 1500, 1600',
                  sizes: '(min-width: 990px) 50vw, 100vw',
                  loading: media_loading,
                  class: 'media-frame__image',
                  alt: media_alt
              }}
            {%- when 'external_video' -%}
              {{ media | external_video_tag: class: 'product-media__video' }}
            {%- when 'video' -%}
              {{ media | video_tag: controls: true, image_size: '1200x', class: 'product-media__video' }}
            {%- when 'model' -%}
              {{ media | model_viewer_tag: class: 'product-media__model', reveal: 'interaction' }}
            {%- else -%}
              {{ media | media_tag }}
          {%- endcase -%}
        </div>
      {%- endfor -%}
    {%- else -%}
      <div class="product-media media-frame">
        {{ 'product-1' | placeholder_svg_tag: 'media-frame__image placeholder-svg' }}
      </div>
    {%- endif -%}
  </div>

  <div class="product__info">
    {%- if featured_product != blank -%}
      {%- form 'product', featured_product, id: product_form_id, class: 'product-form', novalidate: 'novalidate' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-product-id-input>

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'vendor' -%}
              {%- if featured_product.vendor != blank -%}
                <p class="eyebrow" {{ block.shopify_attributes }}>{{ featured_product.vendor }}</p>
              {%- endif -%}

            {%- when 'title' -%}
              <div class="product__title" {{ block.shopify_attributes }}>
                <h2>{{ featured_product.title }}</h2>
              </div>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }}>
                {%- render 'price', product: featured_product, use_variant: true -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless featured_product.has_only_default_variant -%}
                <variant-selects class="variant-picker" data-section="{{ section.id }}" data-url="{{ featured_product.url }}" data-update-url="false" {{ block.shopify_attributes }}>
                  {%- for option in featured_product.options_with_values -%}
                    <fieldset class="product-form__input">
                      <legend>{{ option.name }}</legend>
                      <div class="option-values">
                        {%- for value in option.values -%}
                          {%- liquid
                            assign swatch = value.swatch
                            assign option_dom_id = value.id | default: forloop.index0
                            assign option_id = 'FeaturedOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: option_dom_id
                          -%}
                          <input
                            type="radio"
                            id="{{ option_id }}"
                            name="options[{{ option.name | escape }}]"
                            value="{{ value | escape }}"
                            data-option-value-id="{{ value.id }}"
                            {% if value.product_url != blank %}data-product-url="{{ value.product_url }}"{% endif %}
                            {% if value.selected or option.selected_value == value %}checked{% endif %}
                          >
                          <label
                            for="{{ option_id }}"
                            class="option-value{% if swatch.color or swatch.image %} option-value--swatch{% endif %}{% unless value.available %} option-value--unavailable{% endunless %}"
                            {% if swatch.color %}style="--swatch-color: {{ swatch.color }};"{% endif %}
                          >
                            {%- if swatch.image -%}
                              <span class="option-value__swatch" style="background-image: url({{ swatch.image | image_url: width: 96 }});"></span>
                            {%- elsif swatch.color -%}
                              <span class="option-value__swatch"></span>
                            {%- endif -%}
                            <span>{{ value }}</span>
                          </label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                </variant-selects>
              {%- endunless -%}

            {%- when 'quantity_selector' -%}
              <div class="quantity-field" {{ block.shopify_attributes }}>
                <label for="FeaturedQuantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                <input
                  class="field__input quantity-input"
                  id="FeaturedQuantity-{{ section.id }}"
                  type="number"
                  name="quantity"
                  value="{{ quantity_min }}"
                  min="{{ quantity_min }}"
                  step="{{ quantity_increment }}"
                  {% if quantity_max != blank %}max="{{ quantity_max }}"{% endif %}
                >
                {%- if quantity_min > 1 or quantity_increment > 1 or quantity_max != blank -%}
                  <div class="quantity-rules">
                    {%- if quantity_min > 1 -%}
                      <span>{{ 'products.product.quantity_rule_minimum' | t: quantity: quantity_min }}</span>
                    {%- endif -%}
                    {%- if quantity_max != blank -%}
                      <span>{{ 'products.product.quantity_rule_maximum' | t: quantity: quantity_max }}</span>
                    {%- endif -%}
                    {%- if quantity_increment > 1 -%}
                      <span>{{ 'products.product.quantity_rule_increment' | t: quantity: quantity_increment }}</span>
                    {%- endif -%}
                  </div>
                {%- endif -%}
                {%- if current_variant.quantity_price_breaks.size > 0 -%}
                  <div class="quantity-pricing">
                    <p>{{ 'products.product.volume_pricing' | t }}</p>
                    <ul role="list">
                      {%- for price_break in current_variant.quantity_price_breaks -%}
                        <li>
                          <span>{{ 'products.product.volume_price_break' | t: quantity: price_break.minimum_quantity }}</span>
                          <span>{{ price_break.price | money }} {{ 'products.product.each' | t }}</span>
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                {%- endif -%}
              </div>

            {%- when 'selling_plan_picker' -%}
              {%- if featured_product.selling_plan_groups.size > 0 -%}
                <div class="selling-plan-picker" {{ block.shopify_attributes }}>
                  <label for="FeaturedSellingPlan-{{ section.id }}">{{ 'products.product.selling_plan' | t }}</label>
                  <select id="FeaturedSellingPlan-{{ section.id }}" class="field__input" name="selling_plan">
                    <option value="">{{ 'products.product.one_time_purchase' | t }}</option>
                    {%- for group in featured_product.selling_plan_groups -%}
                      <optgroup label="{{ group.name | escape }}">
                        {%- for selling_plan in group.selling_plans -%}
                          <option value="{{ selling_plan.id }}">{{ selling_plan.name }}</option>
                        {%- endfor -%}
                      </optgroup>
                    {%- endfor -%}
                  </select>
                </div>
              {%- endif -%}

            {%- when 'buy_buttons' -%}
              <div class="product-form__buttons" {{ block.shopify_attributes }}>
                <button
                  type="submit"
                  name="add"
                  class="button product-form__submit"
                  {% unless current_variant.available %}disabled{% endunless %}
                  data-add-to-cart
                >
                  <span data-add-to-cart-text>
                    {%- if current_variant.available -%}
                      {{ 'products.product.add_to_cart' | t }}
                    {%- else -%}
                      {{ 'products.product.sold_out' | t }}
                    {%- endif -%}
                  </span>
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  {{ form | payment_button }}
                {%- endif -%}

                {{ form | payment_terms }}
              </div>

            {%- when 'description' -%}
              {%- if featured_product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ featured_product.description }}
                </div>
              {%- endif -%}

            {%- when 'pickup_availability' -%}
              <pickup-availability
                class="pickup-availability"
                data-root-url="{{ routes.root_url }}"
                data-variant-id="{{ current_variant.id }}"
                data-section-id="pickup-availability"
                {{ block.shopify_attributes }}
              >
                {%- render 'pickup-availability', product: featured_product -%}
              </pickup-availability>

            {%- when 'custom_liquid' -%}
              <div class="custom-liquid" {{ block.shopify_attributes }}>
                {{ block.settings.custom_liquid }}
              </div>

            {%- when '@app' -%}
              {% render block %}
          {%- endcase -%}
        {%- endfor -%}
      {%- endform -%}

      <script type="application/json" id="ProductJson-{{ section.id }}">
        {{ featured_product.variants | json }}
      </script>
    {%- else -%}
      <div class="product-form">
        <p class="eyebrow">{{ 'products.product.vendor' | t }}</p>
        <div class="product__title"><h2>{{ section.settings.placeholder_heading }}</h2></div>
        <div class="price"><span class="price__regular">{{ 1999 | money }}</span></div>
        <a class="button" href="{{ routes.all_products_collection_url }}">{{ 'cart.general.continue_shopping' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.featured_product.s001",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:sections.featured_product.s002"
    },
    {
      "type": "text",
      "id": "placeholder_heading",
      "label": "t:sections.featured_product.s003",
      "default": "Featured shoe"
    }
  ],
  "blocks": [
    {
      "type": "vendor",
      "name": "t:sections.featured_product.s004",
      "limit": 1
    },
    {
      "type": "title",
      "name": "t:sections.featured_product.s005",
      "limit": 1
    },
    {
      "type": "price",
      "name": "t:sections.featured_product.s006",
      "limit": 1
    },
    {
      "type": "variant_picker",
      "name": "t:sections.featured_product.s007",
      "limit": 1
    },
    {
      "type": "quantity_selector",
      "name": "t:sections.featured_product.s008",
      "limit": 1
    },
    {
      "type": "selling_plan_picker",
      "name": "t:sections.featured_product.s009",
      "limit": 1
    },
    {
      "type": "buy_buttons",
      "name": "t:sections.featured_product.s010",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "t:sections.featured_product.s011",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "t:sections.featured_product.s012",
      "limit": 1
    },
    {
      "type": "pickup_availability",
      "name": "t:sections.featured_product.s013",
      "limit": 1
    },
    {
      "type": "custom_liquid",
      "name": "t:sections.featured_product.s014",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "t:sections.featured_product.s015"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "presets": [
    {
      "name": "t:sections.featured_product.s016",
      "blocks": [
        {
          "type": "vendor"
        },
        {
          "type": "title"
        },
        {
          "type": "price"
        },
        {
          "type": "variant_picker"
        },
        {
          "type": "quantity_selector"
        },
        {
          "type": "selling_plan_picker"
        },
        {
          "type": "buy_buttons"
        },
        {
          "type": "description"
        },
        {
          "type": "pickup_availability"
        }
      ]
    }
  ]
}
{% endschema %}
