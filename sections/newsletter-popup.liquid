{%- liquid
  assign brand_name = settings.brand_name | default: shop.name
  assign brand_initial = brand_name | slice: 0, 1
  assign popup_form_id = 'NewsletterPopupForm-' | append: section.id
  assign popup_heading_id = 'NewsletterPopupHeading-' | append: section.id
  assign popup_email_id = 'NewsletterPopupEmail-' | append: section.id
-%}

<div
  id="NewsletterPopup-{{ section.id }}"
  class="newsletter-popup"
  style="--newsletter-popup-background: {{ section.settings.background_color }}; --newsletter-popup-text: {{ section.settings.text_color }}; --newsletter-popup-accent: {{ section.settings.accent_color }};"
  data-newsletter-popup-root
  data-enabled="{{ section.settings.enable_popup }}"
  data-delay="{{ section.settings.delay | times: 1000 }}"
  data-frequency="{{ section.settings.frequency_days }}"
  data-storage-key="treadora-newsletter-popup-{{ section.id }}"
  data-design-mode="{{ request.design_mode }}"
>
  <dialog
    class="newsletter-popup__dialog"
    data-newsletter-popup
    {% if section.settings.heading != blank %}
      aria-labelledby="{{ popup_heading_id }}"
    {% else %}
      aria-label="{{ 'general.newsletter.modal_label' | t }}"
    {% endif %}
  >
    <div class="newsletter-popup__shell newsletter-popup__shell--image-{{ section.settings.image_position }}">
      <button class="newsletter-popup__close" type="button" data-newsletter-popup-close aria-label="{{ 'accessibility.close' | t }}">
        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-linecap="square" stroke-width="1.5"/>
        </svg>
      </button>

      <div class="newsletter-popup__media" aria-hidden="{% if section.settings.image.alt == blank %}true{% else %}false{% endif %}">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag:
              widths: '360, 540, 720, 960, 1200, 1400',
              sizes: '(min-width: 750px) 42vw, 100vw',
              loading: 'lazy',
              class: 'newsletter-popup__image'
          }}
        {%- else -%}
          <div class="newsletter-popup__art">
            <span class="newsletter-popup__art-kicker">{{ section.settings.kicker | default: brand_name }}</span>
            <span class="newsletter-popup__monogram">{{ brand_initial }}</span>
            <span class="newsletter-popup__art-brand">{{ brand_name }}</span>
          </div>
        {%- endif -%}
      </div>

      <div class="newsletter-popup__content">
        {%- if section.settings.kicker != blank -%}
          <p class="newsletter-popup__kicker eyebrow">{{ section.settings.kicker }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 id="{{ popup_heading_id }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="newsletter-popup__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.offer_text != blank -%}
          <p class="newsletter-popup__offer">{{ section.settings.offer_text }}</p>
        {%- endif -%}

        {%- form 'customer', id: popup_form_id, class: 'newsletter-popup__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <p class="newsletter-popup__status" tabindex="-1" data-newsletter-popup-result="success">
              {{ 'general.newsletter.success' | t }}
            </p>
          {%- else -%}
            <label class="visually-hidden" for="{{ popup_email_id }}">{{ 'general.newsletter.label' | t }}</label>
            <div class="newsletter-popup__field">
              <input
                id="{{ popup_email_id }}"
                class="field__input"
                type="email"
                name="contact[email]"
                value="{{ form.email | escape }}"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ 'general.newsletter.placeholder' | t }}"
                required
              >
              <button class="button" type="submit">
                {{ section.settings.button_label }}
              </button>
            </div>
            {%- if form.errors -%}
              <div class="newsletter-popup__status newsletter-popup__status--error" tabindex="-1" data-newsletter-popup-result="error">
                {{ form.errors | default_errors }}
              </div>
            {%- endif -%}
          {%- endif -%}
        {%- endform -%}

        {%- if section.settings.fine_print != blank -%}
          <p class="newsletter-popup__fine-print">{{ section.settings.fine_print }}</p>
        {%- endif -%}
        <button class="newsletter-popup__dismiss" type="button" data-newsletter-popup-close>
          {{ section.settings.dismiss_label }}
        </button>
      </div>
    </div>
  </dialog>
</div>

{% stylesheet %}
  body.newsletter-popup-open {
    overflow: hidden;
  }

  .newsletter-popup__dialog {
    width: min(920px, calc(100% - 48px));
    max-width: none;
    max-height: min(84dvh, 680px);
    margin: auto;
    padding: 0;
    overflow: auto;
    border: 0;
    background: transparent;
    color: var(--newsletter-popup-text);
    box-shadow: 0 28px 90px rgba(0, 0, 0, 0.34);
  }

  .newsletter-popup__dialog::backdrop {
    background: rgba(5, 5, 5, 0.72);
    backdrop-filter: blur(7px);
    animation: newsletter-popup-backdrop 260ms ease both;
  }

  .newsletter-popup__dialog[open] {
    animation: newsletter-popup-enter 420ms cubic-bezier(0.2, 0.72, 0.2, 1) both;
  }

  .newsletter-popup__shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(270px, 0.88fr) minmax(0, 1.12fr);
    min-height: 490px;
    overflow: hidden;
    background: var(--newsletter-popup-background);
  }

  .newsletter-popup__shell--image-right .newsletter-popup__media {
    order: 2;
  }

  .newsletter-popup__close {
    position: absolute;
    z-index: 2;
    top: 16px;
    right: 16px;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid color-mix(in srgb, var(--newsletter-popup-text) 20%, transparent);
    background: color-mix(in srgb, var(--newsletter-popup-background) 84%, transparent);
    color: var(--newsletter-popup-text);
    backdrop-filter: blur(12px);
    transition: background 180ms ease, color 180ms ease, transform 180ms ease;
  }

  .newsletter-popup__close:hover {
    background: var(--newsletter-popup-text);
    color: var(--newsletter-popup-background);
    transform: rotate(4deg);
  }

  .newsletter-popup__close svg {
    width: 18px;
    height: 18px;
  }

  .newsletter-popup__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    background: var(--newsletter-popup-accent);
  }

  .newsletter-popup__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .newsletter-popup__art {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 24px;
    overflow: hidden;
    color: #111;
    isolation: isolate;
  }

  .newsletter-popup__art::before,
  .newsletter-popup__art::after {
    content: '';
    position: absolute;
    z-index: -1;
    border: 1px solid currentColor;
  }

  .newsletter-popup__art::before {
    width: 78%;
    aspect-ratio: 1;
    top: 50%;
    left: 50%;
    border-radius: 50%;
    transform: translate(-50%, -50%);
  }

  .newsletter-popup__art::after {
    inset: 15% -20%;
    transform: rotate(-14deg);
  }

  .newsletter-popup__art-kicker,
  .newsletter-popup__art-brand {
    position: relative;
    z-index: 1;
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .newsletter-popup__art-brand {
    align-self: flex-end;
  }

  .newsletter-popup__monogram {
    position: absolute;
    top: 50%;
    left: 50%;
    font-family: var(--font-heading);
    font-size: clamp(13rem, 30vw, 23rem);
    font-weight: 700;
    line-height: 0.7;
    transform: translate(-50%, -50%);
  }

  .newsletter-popup__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    padding: clamp(46px, 5.5vw, 64px) clamp(28px, 4.5vw, 52px) clamp(34px, 4.5vw, 52px);
  }

  .newsletter-popup__kicker {
    margin-bottom: 18px;
    color: inherit;
    opacity: 0.62;
  }

  .newsletter-popup__content h2 {
    max-width: 580px;
    font-size: clamp(2.25rem, 4.2vw, 3.9rem);
    line-height: 0.9;
    letter-spacing: -0.045em;
  }

  .newsletter-popup__text {
    max-width: 500px;
    margin-top: 18px;
    color: color-mix(in srgb, var(--newsletter-popup-text) 72%, transparent);
    font-size: 1rem;
    line-height: 1.55;
  }
  .newsletter-popup__text p {
    margin: 0;
  }

  .newsletter-popup__offer {
    margin: 14px 0 0;
    font-weight: 700;
  }

  .newsletter-popup__form {
    margin-top: 24px;
  }

  .newsletter-popup__field {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 10px;
  }

  .newsletter-popup__field .field__input {
    min-width: 0;
    border-color: color-mix(in srgb, var(--newsletter-popup-text) 35%, transparent);
    background: transparent;
    color: var(--newsletter-popup-text);
  }

  .newsletter-popup__field .field__input::placeholder {
    color: color-mix(in srgb, var(--newsletter-popup-text) 55%, transparent);
  }

  .newsletter-popup__field .button {
    border-color: var(--newsletter-popup-text);
    background: var(--newsletter-popup-text);
    color: var(--newsletter-popup-background);
  }

  .newsletter-popup__status {
    margin: 24px 0 0;
    font-weight: 700;
  }

  .newsletter-popup__status--error {
    color: #a52618;
  }

  .newsletter-popup__fine-print {
    margin: 13px 0 0;
    color: color-mix(in srgb, var(--newsletter-popup-text) 62%, transparent);
    font-size: 0.76rem;
    line-height: 1.45;
  }

  .newsletter-popup__dismiss {
    align-self: flex-start;
    margin-top: 14px;
    padding: 2px 0;
    border: 0;
    border-bottom: 1px solid currentColor;
    background: transparent;
    color: inherit;
    font-family: var(--font-utility);
    font-size: 0.82rem;
    cursor: pointer;
  }

  @keyframes newsletter-popup-backdrop {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes newsletter-popup-enter {
    from {
      opacity: 0;
      transform: translateY(22px) scale(0.985);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  @media screen and (min-width: 750px) and (max-width: 989px) {
    .newsletter-popup__dialog {
      width: min(780px, calc(100% - 40px));
      max-height: min(82dvh, 620px);
    }

    .newsletter-popup__shell {
      grid-template-columns: minmax(240px, 0.82fr) minmax(0, 1.18fr);
      min-height: 450px;
    }

    .newsletter-popup__content {
      padding: 42px 34px 34px;
    }

    .newsletter-popup__content h2 {
      font-size: clamp(2.2rem, 5vw, 3.25rem);
    }
  }

  @media screen and (max-width: 749px) {
    .newsletter-popup__dialog {
      width: min(400px, calc(100% - 36px));
      max-height: calc(100dvh - 36px);
    }

    .newsletter-popup__shell {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .newsletter-popup__shell--image-right .newsletter-popup__media {
      order: 0;
    }

    .newsletter-popup__media {
      min-height: 120px;
      max-height: 20dvh;
    }

    .newsletter-popup__content {
      padding: 28px 20px 24px;
    }

    .newsletter-popup__content h2 {
      font-size: clamp(1.9rem, 9vw, 2.65rem);
    }

    .newsletter-popup__field {
      grid-template-columns: 1fr;
    }

    .newsletter-popup__field .button {
      width: 100%;
    }

    .newsletter-popup__close {
      top: 12px;
      right: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .newsletter-popup__dialog,
    .newsletter-popup__dialog::backdrop {
      animation: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  (() => {
    const selector = '[data-newsletter-popup-root]';

    const setPageState = () => {
      document.body.classList.toggle(
        'newsletter-popup-open',
        Boolean(document.querySelector('[data-newsletter-popup][open]'))
      );
    };

    const initialize = (root) => {
      if (root.dataset.newsletterPopupInitialized === 'true') return;

      const dialog = root.querySelector('[data-newsletter-popup]');
      if (!dialog) return;

      root.dataset.newsletterPopupInitialized = 'true';
      const closeButtons = root.querySelectorAll('[data-newsletter-popup-close]');
      const result = root.querySelector('[data-newsletter-popup-result]');
      const email = root.querySelector('input[type="email"]');
      const designMode = root.dataset.designMode === 'true';
      const enabled = root.dataset.enabled === 'true';
      const delay = Math.max(0, Number(root.dataset.delay) || 0);
      const frequency = Math.max(1, Number(root.dataset.frequency) || 1) * 86400000;
      const storageKey = root.dataset.storageKey;
      let timer;

      const remember = () => {
        try {
          localStorage.setItem(storageKey, String(Date.now()));
        } catch (error) {
          return;
        }
      };

      const wasShownRecently = () => {
        try {
          const lastShown = Number(localStorage.getItem(storageKey));
          return Number.isFinite(lastShown) && Date.now() - lastShown < frequency;
        } catch (error) {
          return false;
        }
      };

      const show = (rememberVisit = true) => {
        window.clearTimeout(timer);
        if (!dialog.open) {
          if (typeof dialog.showModal === 'function') {
            dialog.showModal();
          } else {
            dialog.setAttribute('open', '');
          }
        }
        if (rememberVisit && !designMode) remember();
        setPageState();
        window.setTimeout(() => (result || email)?.focus(), 50);
      };

      const hide = () => {
        window.clearTimeout(timer);
        if (dialog.open) {
          if (typeof dialog.close === 'function') {
            dialog.close();
          } else {
            dialog.removeAttribute('open');
          }
        }
        if (!designMode) remember();
        setPageState();
      };

      closeButtons.forEach((button) => button.addEventListener('click', hide));
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        hide();
      });
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) hide();
      });
      dialog.addEventListener('close', setPageState);

      if (result) {
        show(false);
      } else if (designMode) {
        show(false);
      } else if (enabled && !wasShownRecently()) {
        timer = window.setTimeout(show, delay);
      }

      root.addEventListener('shopify:block:select', () => show(false));
    };

    const initializeAll = (scope = document) => {
      if (scope.matches?.(selector)) initialize(scope);
      scope.querySelectorAll?.(selector).forEach(initialize);
    };

    initializeAll();
    document.addEventListener('shopify:section:load', (event) => initializeAll(event.target));
    document.addEventListener('shopify:section:select', (event) => {
      const root = event.target.matches?.(selector) ? event.target : event.target.querySelector?.(selector);
      if (root) {
        initialize(root);
        const dialog = root.querySelector('[data-newsletter-popup]');
        if (dialog && !dialog.open) {
          if (typeof dialog.showModal === 'function') dialog.showModal();
          else dialog.setAttribute('open', '');
          setPageState();
        }
      }
    });
    document.addEventListener('shopify:section:unload', setPageState);
  })();
{% endjavascript %}

{% schema %}
{
  "name": "t:sections.newsletter_popup.s001",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_popup",
      "label": "t:sections.newsletter_popup.s002",
      "default": true
    },
    {
      "type": "range",
      "id": "delay",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "t:sections.newsletter_popup.s003",
      "default": 6
    },
    {
      "type": "range",
      "id": "frequency_days",
      "min": 1,
      "max": 90,
      "step": 1,
      "unit": "d",
      "label": "t:sections.newsletter_popup.s004",
      "default": 14
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.newsletter_popup.s005",
      "default": "Stay in step"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.newsletter_popup.s006",
      "default": "Be first in line"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:sections.newsletter_popup.s007",
      "default": "<p>Get early access to new drops, restocks, and practical fit notes.</p>"
    },
    {
      "type": "text",
      "id": "offer_text",
      "label": "t:sections.newsletter_popup.s008",
      "default": "Fresh footwear stories, sent sparingly."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.newsletter_popup.s009"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:sections.newsletter_popup.s010",
      "options": [
        {
          "value": "left",
          "label": "t:sections.newsletter_popup.s011"
        },
        {
          "value": "right",
          "label": "t:sections.newsletter_popup.s012"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:sections.newsletter_popup.s013",
      "default": "Join the list"
    },
    {
      "type": "text",
      "id": "dismiss_label",
      "label": "t:sections.newsletter_popup.s014",
      "default": "No thanks"
    },
    {
      "type": "text",
      "id": "fine_print",
      "label": "t:sections.newsletter_popup.s015",
      "default": "By subscribing, you agree to receive marketing emails. Unsubscribe at any time."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:sections.newsletter_popup.s016",
      "default": "#f6f4ef"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:sections.newsletter_popup.s017",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "t:sections.newsletter_popup.s018",
      "default": "#a6bd2f"
    }
  ],
  "presets": [
    {
      "name": "t:sections.newsletter_popup.s019"
    }
  ]
}
{% endschema %}
