  }

  .product--main .product-media__caption a {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 28px;
  }

  .product--main .product__media-thumbnails {
    order: 0;
    min-width: 0;
    flex-direction: row;
    gap: 10px;
    max-height: none;
    padding: 4px;
