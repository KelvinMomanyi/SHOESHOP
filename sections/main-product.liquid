{% endstylesheet %}

{% javascript %}
  if (!customElements.get('product-quantity')) {
    customElements.define('product-quantity', class extends HTMLElement {
      connectedCallback() {
        requestAnimationFrame(() => this.initialize());
      }

      initialize() {
        if (!this.isConnected || this.initialized) return;
        this.initialized = true;
        const input = this.querySelector('input');
        const buttons = [...this.querySelectorAll('[data-quantity-step]')];
        if (!input) return;
        const update = () => {
          const value = Number(input.value || input.min || 1);
          buttons.forEach((button) => {
            const direction = Number(button.dataset.quantityStep);
            button.disabled = direction < 0
              ? value <= Number(input.min || 1)
              : input.max !== '' && value >= Number(input.max);
          });
        };
        buttons.forEach((button) => {
          button.hidden = false;
          button.addEventListener('click', () => {
            input.stepUp(Number(button.dataset.quantityStep));
            input.dispatchEvent(new Event('input', { bubbles: true }));
            input.dispatchEvent(new Event('change', { bubbles: true }));
          });
        });
        input.addEventListener('input', update);
        input.addEventListener('change', update);
        update();
      }
    });
  }

  if (!customElements.get('product-detail-tabs')) {
    customElements.define('product-detail-tabs', class extends HTMLElement {
      connectedCallback() {
        requestAnimationFrame(() => this.initialize());
      }

      initialize() {
        if (!this.isConnected || this.initialized) return;
        this.initialized = true;
        this.tabs = [...this.querySelectorAll('[data-product-tab]')];
        this.panels = this.tabs.map((tab) => this.querySelector(tab.hash));
        if (!this.tabs.length || this.panels.some((panel) => !panel)) return;
        const nav = this.querySelector('nav');
        nav.setAttribute('role', 'tablist');
        this.tabs.forEach((tab, index) => {
          tab.setAttribute('role', 'tab');
          tab.setAttribute('aria-controls', this.panels[index].id);
          this.panels[index].setAttribute('role', 'tabpanel');
          this.panels[index].setAttribute('aria-labelledby', tab.id);
          this.panels[index].tabIndex = 0;
          tab.addEventListener('click', (event) => {
            event.preventDefault();
            this.select(index);
          });
          tab.addEventListener('keydown', (event) => {
            const rtl = getComputedStyle(this).direction === 'rtl';
            let next = index;
            if (event.key === 'ArrowRight') next += rtl ? -1 : 1;
            else if (event.key === 'ArrowLeft') next += rtl ? 1 : -1;
            else if (event.key === 'Home') next = 0;
            else if (event.key === 'End') next = this.tabs.length - 1;
            else if (event.key === ' ') next = index;
            else return;
            event.preventDefault();
            next = (next + this.tabs.length) % this.tabs.length;
            this.select(next);
            this.tabs[next].focus();
          });
        });
        const linkedIndex = this.tabs.findIndex((tab) => tab.hash === window.location.hash);
        this.select(Math.max(0, linkedIndex));
      }

      select(index) {
        this.tabs.forEach((tab, i) => {
          const active = i === index;
          tab.setAttribute('aria-selected', String(active));
          tab.tabIndex = active ? 0 : -1;
          this.panels[i].hidden = !active;
        });
      }
    });

    document.addEventListener('click', (event) => {
      const link = event.target.closest('[data-open-product-details]');
      if (!link) return;
      const product = link.closest('.product--main');
      const panel = product?.querySelector(link.hash);
      const tabs = panel?.closest('product-detail-tabs');
      if (!tabs?.tabs) return;
      const index = tabs.tabs.findIndex((tab) => tab.hash === link.hash);
      if (index < 0) return;
      event.preventDefault();
      tabs.select(index);
      panel.scrollIntoView({ block: 'start' });
      panel.focus({ preventScroll: true });
    });
  }
{% endjavascript %}

