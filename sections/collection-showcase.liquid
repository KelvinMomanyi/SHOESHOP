<section class="collection-showcase section-band">
  <div class="page-width">
    <div class="section-heading reveal-item">
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker }}</p>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text }}</p>
      {%- endif -%}
    </div>

    <div class="collection-showcase__grid" data-hover-preview>
      <div class="collection-showcase__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign featured_collection = block.settings.collection
            assign title = block.settings.title | default: featured_collection.title
            assign link = block.settings.link | default: featured_collection.url
          -%}
          <a class="collection-row" href="{{ link | default: routes.collections_url }}" data-preview-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <strong>{{ title | default: 'Collection title' }}</strong>
            <em>{{ block.settings.caption | default: featured_collection.products_count | append: ' products' }}</em>
          </a>
        {%- else -%}
          {%- for i in (1..4) -%}
            <a class="collection-row" href="{{ routes.collections_url }}" data-preview-index="{{ forloop.index0 }}">
              <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <strong>{{ 'general.onboarding.collection_title' | t }}</strong>
              <em>{{ 'general.onboarding.curated_edit' | t }}</em>
            </a>
          {%- endfor -%}
        {%- endfor -%}
      </div>

      <div class="collection-showcase__preview" aria-hidden="true">
        {%- for block in section.blocks -%}
          {%- liquid
            assign featured_collection = block.settings.collection
            assign image = block.settings.image | default: featured_collection.image
            if forloop.first and section.settings.main_image != blank
              assign image = section.settings.main_image
            endif
          -%}
          <div class="collection-preview-image{% if forloop.first %} is-active{% endif %}" data-preview-image="{{ forloop.index0 }}">
            {%- render 'responsive-image',
              image: image,
              class: 'collection-preview-image__img',
              sizes: '(min-width: 990px) 35vw, 80vw'
            -%}
          </div>
        {%- else -%}
          <div class="collection-preview-image is-active" data-preview-image="0">
            {%- if section.settings.main_image != blank -%}
              {%- render 'responsive-image',
                image: section.settings.main_image,
                class: 'collection-preview-image__img',
                sizes: '(min-width: 990px) 35vw, 80vw'
              -%}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'collection-preview-image__img placeholder-svg' }}
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_showcase.s001",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.collection_showcase.s002",
      "default": "Shop by need"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.collection_showcase.s003",
      "default": "Find the right pair"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.collection_showcase.s004"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "t:sections.collection_showcase.s012",
      "info": "t:sections.collection_showcase.s013"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:sections.collection_showcase.s005",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.collection_showcase.s006"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.collection_showcase.s007"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.collection_showcase.s008"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.collection_showcase.s009"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.collection_showcase.s010"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.collection_showcase.s011",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
