<section class="contact-editorial" data-editorial-motion data-motion-enabled="{{ section.settings.enable_motion }}">
  <div class="page-width">
    <div class="contact-editorial__topline">
      {%- if section.settings.kicker != blank -%}
        <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
      {%- endif -%}
      <a class="text-link" href="{{ routes.root_url }}">{{ 'general.navigation.home' | t }} <span aria-hidden="true">&nearr;</span></a>
    </div>
    <div class="contact-editorial__layout">
      <div class="contact-editorial__intro-wrap">
        <div class="contact-editorial__intro" data-editorial-sticky>
          <h1 class="reveal-item">{{ page.title | default: section.settings.heading | escape }}</h1>
          {%- if section.settings.text != blank -%}
            <p class="contact-editorial__description">{{ section.settings.text | escape }}</p>
          {%- endif -%}
          <div class="contact-editorial__topics">
            <p>{{ 'general.contact.here_to_help' | t }}</p>
            <ul role="list">
              <li><span aria-hidden="true">01</span>{{ 'general.contact.orders' | t }}</li>
              <li><span aria-hidden="true">02</span>{{ 'general.contact.sizing' | t }}</li>
              <li><span aria-hidden="true">03</span>{{ 'general.contact.partnerships' | t }}</li>
            </ul>
          </div>
          <span class="contact-editorial__mark" aria-hidden="true">&searr;</span>
        </div>
      </div>

      <div class="contact-editorial__form-panel">
        <header class="contact-editorial__form-heading">
          <p class="eyebrow">{{ 'general.contact.send_note' | t }}</p>
          {%- if section.settings.form_heading != blank -%}
            <h2>{{ section.settings.form_heading | escape }}</h2>
          {%- endif -%}
          <p>{{ 'general.contact.required_fields' | t }}</p>
        </header>
        {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
        {%- form 'contact', id: contact_form_id, class: 'contact-form contact-editorial__form' -%}
          {%- if form.posted_successfully? -%}
            <p class="form-status contact-editorial__status" role="status" tabindex="-1" autofocus>{{ 'general.contact.success' | t }}</p>
          {%- elsif form.errors -%}
            <div class="form-status form-status--error contact-editorial__status" id="ContactErrors-{{ section.id }}" role="alert" tabindex="-1" autofocus>{{ form.errors | default_errors }}</div>
          {%- endif -%}

          <div class="contact-editorial__field">
            <label for="ContactName-{{ section.id }}"><span aria-hidden="true">01</span>{{ 'general.contact.name' | t }} <span class="contact-editorial__optional">{{ 'general.contact.optional' | t }}</span></label>
            <input id="ContactName-{{ section.id }}" class="field__input" type="text" name="contact[name]" value="{% if form.name %}{{ form.name | escape }}{% elsif customer %}{{ customer.name | escape }}{% endif %}" autocomplete="name">
          </div>
          <div class="contact-editorial__field">
            <label for="ContactEmail-{{ section.id }}"><span aria-hidden="true">02</span>{{ 'general.contact.email' | t }} <span aria-hidden="true">*</span></label>
            <input id="ContactEmail-{{ section.id }}" class="field__input" type="email" name="contact[email]" value="{% if form.email %}{{ form.email | escape }}{% elsif customer %}{{ customer.email | escape }}{% endif %}" autocomplete="email" autocorrect="off" autocapitalize="off" required{% if form.errors contains 'email' %} aria-invalid="true" aria-describedby="ContactErrors-{{ section.id }}"{% endif %}>
          </div>
          <div class="contact-editorial__field">
            <label for="ContactMessage-{{ section.id }}"><span aria-hidden="true">03</span>{{ 'general.contact.message' | t }} <span aria-hidden="true">*</span></label>
            <textarea id="ContactMessage-{{ section.id }}" class="field__input" name="contact[body]" rows="6" required{% if form.errors contains 'body' %} aria-invalid="true" aria-describedby="ContactErrors-{{ section.id }}"{% endif %}>{{ form.body | escape }}</textarea>
          </div>
          <button class="button contact-editorial__submit" type="submit">{{ 'general.contact.send_message' | t }} <span aria-hidden="true">&nearr;</span></button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .contact-editorial {
    padding-block: clamp(28px, 4vw, 56px) clamp(64px, 8vw, 112px);
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .contact-editorial__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--color-border);
  }

  .contact-editorial__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.95fr);
    gap: clamp(32px, 7vw, 104px);
    padding-top: clamp(40px, 6vw, 88px);
  }

  .contact-editorial__topline .text-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
  }

  .contact-editorial__intro {
    display: grid;
    gap: 24px;
  }

  .contact-editorial.has-sticky-intro .contact-editorial__intro {
    position: sticky;
    top: var(--editorial-top, 130px);
  }

  .contact-editorial h1 {
    max-width: 9ch;
    font-size: clamp(64px, 9.8vw, 144px);
    line-height: 0.94;
    letter-spacing: -0.065em;
  }

  .contact-editorial__description {
    max-width: 32ch;
    color: var(--color-muted);
    font-size: clamp(17px, 1.5vw, 21px);
    line-height: 1.6;
  }

  .contact-editorial__topics {
    max-width: 380px;
    margin-top: 12px;
    font-family: var(--font-utility);
    font-size: 12px;
  }

  .contact-editorial__topics > p {
    margin-bottom: 16px;
    color: var(--color-muted);
  }

  .contact-editorial__topics ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-editorial__topics li {
    display: flex;
    align-items: center;
    gap: 20px;
    padding-block: 14px;
    border-top: 1px solid var(--color-border);
  }

  .contact-editorial__topics li span {
    color: var(--color-muted);
    font-size: 10px;
  }

  .contact-editorial__mark {
    display: grid;
    place-items: center;
    width: 92px;
    height: 92px;
    margin-top: 8px;
    border-radius: 50%;
    background: var(--color-accent);
    color: var(--color-accent-text);
    font-size: 48px;
    line-height: 1;
  }

  .contact-editorial__form-panel {
    min-width: 0;
    padding: clamp(24px, 3.6vw, 52px);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
    color: var(--color-surface-text);
  }

  .contact-editorial__form-heading {
    display: grid;
    gap: 14px;
    padding-bottom: 32px;
  }

  .contact-editorial__form-heading h2 {
    font-size: clamp(36px, 4vw, 56px);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .contact-editorial__form-heading > p:last-child {
    color: var(--color-muted);
    font-family: var(--font-utility);
    font-size: 12px;
  }

  .contact-form.contact-editorial__form {
    gap: 28px;
  }

  .contact-editorial__field label {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 10px;
    font-family: var(--font-utility);
    font-size: 12px;
    font-weight: 500;
  }

  .contact-editorial__field label > span:first-child {
    color: var(--color-muted);
    font-size: 10px;
  }

  .contact-editorial__field .contact-editorial__optional {
    margin-left: auto;
    color: var(--color-muted);
    font-size: 10px;
  }

  .contact-editorial__field .field__input {
    width: 100%;
    min-height: 48px;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    border-radius: 0;
    background: transparent;
    color: var(--color-surface-text);
    box-shadow: none;
    font-size: 16px;
    transition: border-color 180ms ease;
  }

  .contact-editorial__field textarea.field__input {
    min-height: 156px;
    resize: vertical;
  }

  .contact-editorial__field .field__input:focus-visible {
    border-bottom-color: var(--color-foreground);
    outline: 2px solid var(--color-accent);
    outline-offset: 5px;
  }

  .contact-editorial__field .field__input[aria-invalid="true"] {
    border-bottom-color: var(--color-accent-2);
  }

  .contact-editorial__submit {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    min-height: 58px;
    margin-top: 4px;
    border-radius: 0;
  }

  .contact-editorial__submit span {
    font-size: 24px;
    transition: transform 240ms ease;
  }

  .contact-editorial__submit:hover span,
  .contact-editorial__submit:focus-visible span {
    transform: translate(3px, -3px);
  }

  .contact-editorial__status {
    margin: 0;
    padding: 18px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .contact-editorial__status.form-status--error {
    border-color: var(--color-accent-2);
    color: var(--color-foreground);
  }

  .no-js .contact-editorial .reveal-item {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 989px) {
    .contact-editorial__layout {
      grid-template-columns: 1fr;
      gap: 36px;
    }

    .contact-editorial h1 {
      font-size: clamp(64px, 13vw, 120px);
    }

    .contact-editorial__topics,
    .contact-editorial__mark {
      display: none;
    }

    .contact-editorial__description {
      max-width: 44ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-editorial.has-sticky-intro .contact-editorial__intro {
      position: static;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.contact_form.s001",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.contact_form.s002",
      "default": "t:sections.contact_form.default_kicker"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.contact_form.s003",
      "default": "t:sections.contact_form.default_heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:sections.contact_form.s004",
      "default": "t:sections.contact_form.default_text"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "t:sections.contact_form.form_heading",
      "default": "t:sections.contact_form.default_form_heading"
    },
    {
      "type": "checkbox",
      "id": "enable_motion",
      "label": "t:sections.contact_form.enable_motion",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:sections.contact_form.s005"
    }
  ]
}
{% endschema %}
