<section class="customer-page section-band">
  <div class="page-width customer-auth">
    <div class="section-heading">
      <p class="eyebrow">{{ settings.brand_name | default: 'Treadora' }}</p>
      <h1>{{ 'customer.reset_password.title' | t }}</h1>
    </div>

    {%- form 'reset_customer_password', class: 'customer-form' -%}
      {{ form.errors | default_errors }}
      <div>
        <label for="ResetPassword-{{ section.id }}">{{ 'customer.login.password' | t }}</label>
        <input id="ResetPassword-{{ section.id }}" class="field__input" type="password" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div>
        <label for="ResetPasswordConfirmation-{{ section.id }}">{{ 'customer.reset_password.password_confirmation' | t }}</label>
        <input id="ResetPasswordConfirmation-{{ section.id }}" class="field__input" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button class="button" type="submit">{{ 'customer.reset_password.submit' | t }}</button>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "t:sections.main_customers_reset_password.s001"
}
{% endschema %}
