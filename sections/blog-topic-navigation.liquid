<section class="blog-topic-navigation">
  <div class="page-width">
    <header class="blog-topic-navigation__masthead reveal-item">
      <div class="blog-topic-navigation__title">
        {%- if section.settings.kicker != blank -%}
          <p class="eyebrow">{{ section.settings.kicker | escape }}</p>
        {%- endif -%}
        <h1>{{ blog.title | escape }}</h1>
      </div>

      <div class="blog-topic-navigation__summary">
        <p class="blog-topic-navigation__count">{{ 'blog.articles.story_count' | t: count: blog.articles_count }}</p>
        {%- if section.settings.intro != blank -%}
          <p>{{ section.settings.intro | escape }}</p>
        {%- endif -%}
      </div>
    </header>

    <div class="blog-topic-navigation__bar">
      <h2>{{ section.settings.heading | escape }}</h2>
      <nav class="blog-topic-navigation__links" aria-label="{{ section.settings.heading | escape }}">
        <span class="blog-topic-navigation__link{% if current_tags == blank %} is-active{% endif %}">
          <a href="{{ blog.url }}"{% if current_tags == blank %} aria-current="page"{% endif %}>{{ section.settings.all_label | escape }}</a>
        </span>
        {%- for tag in blog.all_tags limit: section.settings.tags_to_show -%}
          <span class="blog-topic-navigation__link{% if current_tags contains tag %} is-active{% endif %}">
            {%- assign topic_link = tag | link_to_tag: tag -%}
            {%- if current_tags contains tag -%}
              {{- topic_link | replace: '<a ', '<a aria-current="page" ' -}}
            {%- else -%}
              {{- topic_link -}}
            {%- endif -%}
          </span>
        {%- endfor -%}
      </nav>
    </div>
  </div>
</section>

{% stylesheet %}
  .blog-topic-navigation {
    background: var(--color-background);
    color: var(--color-foreground);
  }

  .blog-topic-navigation__masthead {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(240px, 0.5fr);
    align-items: end;
    gap: clamp(24px, 5vw, 72px);
    padding-block: clamp(36px, 5vw, 72px) clamp(40px, 5vw, 72px);
  }

  .blog-topic-navigation__title {
    display: grid;
    gap: 22px;
    min-width: 0;
  }

  .blog-topic-navigation__title h1 {
    max-width: 11ch;
    font-size: clamp(64px, 12.5vw, 180px);
    line-height: 0.9;
    letter-spacing: -0.065em;
  }

  .blog-topic-navigation__summary {
    display: grid;
    gap: 18px;
    max-width: 34ch;
    color: var(--color-muted);
    font-size: clamp(16px, 1.35vw, 19px);
    line-height: 1.6;
  }

  .blog-topic-navigation__count {
    color: var(--color-foreground);
    font-family: var(--font-utility);
    font-size: 11px;
    text-transform: uppercase;
  }

  .blog-topic-navigation__bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 24px;
    padding-block: 18px;
    border-block: 1px solid var(--color-border);
  }

  .blog-topic-navigation__bar h2 {
    font-family: var(--font-utility);
    font-size: 12px;
    font-weight: 500;
  }

  .blog-topic-navigation__links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    min-width: 0;
    padding: 4px;
  }

  .blog-topic-navigation__link {
    flex: 0 0 auto;
    max-width: 100%;
  }

  .blog-topic-navigation__link a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 10px 16px;
    border: 1px solid var(--color-border);
    border-radius: 30px;
    font-family: var(--font-utility);
    font-size: 11px;
    transition: border-color 180ms ease, background 180ms ease, color 180ms ease;
  }

  .blog-topic-navigation__link a:hover,
  .blog-topic-navigation__link a:focus-visible,
  .blog-topic-navigation__link.is-active a {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-accent-text);
  }

  .no-js .blog-topic-navigation .reveal-item {
    opacity: 1;
    transform: none;
  }

  @media (max-width: 749px) {
    .blog-topic-navigation__masthead {
      grid-template-columns: 1fr;
      gap: 28px;
      padding-block: 36px 32px;
    }

    .blog-topic-navigation__title h1 {
      font-size: clamp(56px, 16vw, 104px);
    }

    .blog-topic-navigation__bar {
      grid-template-columns: 1fr;
      gap: 14px;
      padding-block: 18px;
    }

    .blog-topic-navigation__links {
      justify-content: flex-start;
      padding: 4px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:sections.blog_topic_navigation.s001",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.blog_topic_navigation.s002",
      "default": "Treadora journal"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "t:sections.blog_topic_navigation.s006",
      "default": "Stories about footwear, movement, materials, and the culture that connects them."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.blog_topic_navigation.s003",
      "default": "Browse by topic"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "t:sections.blog_topic_navigation.s004",
      "default": "All stories"
    },
    {
      "type": "range",
      "id": "tags_to_show",
      "label": "t:sections.blog_topic_navigation.s005",
      "min": 3,
      "max": 12,
      "step": 1,
      "default": 8
    }
  ]
}
{% endschema %}
