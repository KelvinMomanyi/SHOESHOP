<section class="hover-preview">
  <div class="hover-preview__inner page-width" data-hover-preview data-follow-preview>
    {%- if section.settings.show_heading and section.settings.heading != blank -%}
      <div class="hover-preview__heading reveal-item">
        {%- if section.settings.kicker != blank -%}
          <p class="eyebrow">{{ section.settings.kicker }}</p>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {%- endif -%}

    <div class="hover-preview__rows">
      {%- for block in section.blocks -%}
        <a class="hover-row reveal-item" href="{{ block.settings.link | default: routes.all_products_collection_url }}" data-preview-index="{{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <strong>{{ block.settings.title | default: 'Featured collection' }}</strong>
          <span>{{ block.settings.caption | default: 'Shop now' }}</span>
        </a>
      {%- else -%}
        {%- for i in (1..4) -%}
          <a class="hover-row reveal-item" href="{{ routes.all_products_collection_url }}" data-preview-index="{{ forloop.index0 }}">
            <strong>{{ 'general.onboarding.featured_collection' | t }}</strong>
            <span>{{ 'general.onboarding.shop_now' | t }}</span>
          </a>
        {%- endfor -%}
      {%- endfor -%}
    </div>

    <div class="hover-preview__thumbnail" aria-hidden="true" data-floating-preview>
      <div class="hover-preview__track" data-preview-track>
      {%- for block in section.blocks -%}
        <div class="hover-preview__image" data-preview-image="{{ forloop.index0 }}">
          {%- if block.settings.image != blank -%}
            {%- render 'responsive-image',
              image: block.settings.image,
              class: 'hover-preview__img',
              sizes: '(min-width: 990px) 400px, 80vw',
              alt: block.settings.title
            -%}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'hover-preview__img placeholder-svg' }}
          {%- endif -%}
        </div>
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="hover-preview__image" data-preview-image="{{ forloop.index0 }}">
            {{ 'collection-1' | placeholder_svg_tag: 'hover-preview__img placeholder-svg' }}
          </div>
        {%- endfor -%}
      {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.hover_preview.s001",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "t:sections.hover_preview.s002",
      "default": "Shop by pace"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hover_preview.s003",
      "default": "Choose your rotation"
    },
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "t:sections.hover_preview.s004",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "t:sections.hover_preview.s005",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "t:sections.hover_preview.s006",
          "default": "Daily trainers"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "t:sections.hover_preview.s007",
          "default": "Footwear collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.hover_preview.s008"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.hover_preview.s009"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.hover_preview.s010",
      "blocks": [
        {
          "type": "row"
        },
        {
          "type": "row"
        },
        {
          "type": "row"
        }
      ]
    }
  ]
}
{% endschema %}
